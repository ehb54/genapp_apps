
. ~/openrc.sh

# create security group

nova secgroup-create global-ssh "ssh & icmp enabled"
nova secgroup-add-rule global-ssh tcp 22 22 0.0.0.0/0
nova secgroup-add-rule global-ssh icmp -1 -1 0.0.0.0/0

nova secgroup-create global-http "ssh, http & icmp enabled"
nova secgroup-add-rule global-http tcp 22 22 0.0.0.0/0
nova secgroup-add-rule global-http tcp 80 80 0.0.0.0/0
nova secgroup-add-rule global-http icmp -1 -1 0.0.0.0/0

nova secgroup-create global-https "ssh, http, https & icmp enabled"
nova secgroup-add-rule global-https tcp 22 22 0.0.0.0/0
nova secgroup-add-rule global-https tcp 80 80 0.0.0.0/0
nova secgroup-add-rule global-https tcp 443 443 0.0.0.0/0
nova secgroup-add-rule global-https icmp -1 -1 0.0.0.0/0

nova secgroup-create nfslocal "nfslocal"
nova secgroup-add-rule nfslocal tcp 111 111 10.0.0.0/8
nova secgroup-add-rule nfslocal udp 111 111 10.0.0.0/8
nova secgroup-add-rule nfslocal tcp 892 892 10.0.0.0/8
nova secgroup-add-rule nfslocal udp 892 892 10.0.0.0/8
nova secgroup-add-rule nfslocal tcp 1110 1110 10.0.0.0/8
nova secgroup-add-rule nfslocal udp 1110 1110 10.0.0.0/8
nova secgroup-add-rule nfslocal tcp 2049 2049 10.0.0.0/8
nova secgroup-add-rule nfslocal udp 2049 2049 10.0.0.0/8
nova secgroup-add-rule nfslocal tcp 4045 4045 10.0.0.0/8
nova secgroup-add-rule nfslocal udp 4045 4045 10.0.0.0/8
nova secgroup-add-rule nfslocal udp 32769 32769 10.0.0.0/8
nova secgroup-add-rule nfslocal tcp 32803 32803 10.0.0.0/8

# other useful secgroup commands

nova secgroup-list
nova secgroup-delete XXX

nova add-secgroup image group
nova remove-secgroup image group
# keys

nova keypair-list
 
# setup networking

neutron net-list



