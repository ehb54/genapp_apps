
. ~/openrc.sh

# create security group

nova secgroup-create global-ssh "ssh & icmp enabled"
nova secgroup-add-rule global-ssh tcp 22 22 0.0.0.0/0
nova secgroup-add-rule global-ssh icmp -1 -1 0.0.0.0/0

nova secgroup-create global-http "ssh, http & icmp enabled"
nova secgroup-add-rule global-http tcp 22 22 0.0.0.0/0
nova secgroup-add-rule global-http tcp 80 80 0.0.0.0/0
nova secgroup-add-rule global-http icmp -1 -1 0.0.0.0/0

nova secgroup-create global-https "ssh, http, https & icmp enabled"
nova secgroup-add-rule global-https tcp 22 22 0.0.0.0/0
nova secgroup-add-rule global-https tcp 80 80 0.0.0.0/0
nova secgroup-add-rule global-https tcp 443 443 0.0.0.0/0
nova secgroup-add-rule global-https icmp -1 -1 0.0.0.0/0

# other useful secgroup commands

nova secgroup-list
nova secgroup-delete XXX

# keys

nova keypair-list
 
# setup networking

neutron net-list



----


design notes:

main server running genapp namdrunner, running nfs and attached to a volume


the namd jobs will startup an openstack cluster, each will mount the nfs and give back the ip addresses

1-> start openstack genapp instance

