# --- mkdir directories on comet
sub addarg { 
    my $opt = $_[0];
    my $arg = $_[1];
    return " -$opt $arg";
}

my $jobid;
my $output_dir;
my $ok = 1;

my $remotesys  = $$remote{ "sys" };

{
    my $genmap     = $$remote{ "genmap" };
    my $userdir    = $$remote{ "userdir" } . "/" . $$ref{ "_uuid" };
    my $stage      = $$remote{ "stage" } . "/" . $$ref{ "_uuid" };
    sendmsg( "staging files to $remotesys:$stage\n", .03 );

    my $cmd = "ssh $remotesys mkdir -p $stage\n";
    $cmd .= "scp spr_ell.usr spr_ell.rea SIZE $remotesys:$stage/\n";
    if ( $use_genmap ) {
        $cmd .= "ssh $remotesys 'cd $stage; $genmap <<EOT
spr_ell
0.05
EOT
'";
    }
    print "cmd is:\n$cmd\n" if $debug;
    my $results = `$cmd 2>&1`;
    print "results:\n$results\n" if $debug;

    if ( $run_genmap ) {
        $ok = $results =~ /writing spr_ell.map/;
        print ( $ok ? "genmap ok\n" : "genmap failed\n" ) if $debug;
        sendmsg( "genmap " . ( $ok ? "success" : "failure" ) . "\n", 0.04 );
    }

    if ( $ok ) {
#  /usr/bin/gsissh -p 22 -x Comet /home/gridchem/bin/dev/gridchem_common -C nek5000 -a uic151 -q compute -W 1:30 -n 24 -M 4000 -g spamidig -p spamidig_proj -e 'ccg-admin\@gridchem.uits.iu.edu,emre\@biochem.uthscsa.edu' -O /home/gridchem/vortixshedding/tmp -l 0 -j default_job /home/gridchem/spamidig/tempdirs/tempdirhNebfVJ/ext_cyl.usr,ext_cyl.rea,ext_cyl.map,SIZE      
        $cmd = "ssh $remotesys '/home/gridchem/bin/dev/gridchem_common"
            . addarg( "C", "nek5000" )
            . addarg( "a", "uic319" )
            . addarg( "q", "compute" )
            . addarg( "W", $maxruntime )
            . addarg( "n", 24 )
            . addarg( "M", 4000 )
            . addarg( "g", $$ref{"_logon"} )
            . addarg( "p", "vortexshedding_proj" )
            . addarg( "e", 'ccg-admin@gridchem.uits.iu.edu,emre@biochem.uthscsa.edu' )
            . addarg( "O", $stage )
            . addarg( "l", 0 )
            . addarg( "j", "default_job" )
            . " $stage/spr_ell.usr,spr_ell.rea,SIZE"
            . "'\n";

        sendmsg( "Submitting job to Comet\n", 0.05 );
        print "cmd is:\n$cmd\n" if $debug;
        my $results = `$cmd 2>&1`;
        print "results:\n$results\n" if $debug;
        ( my $jobid_submitted )            = $results =~ /\nSubmitted batch job (\d+)\n/;
        ( my $jobid_cluster_script )       = $results =~ /\nJOBID_FROM_CLUSTER_SCRIPT= (\d+)\n/;
        ( my $scratchdir_cluster_script )  = $results =~ /\nSCRATCHDIR_FROM_CLUSTER_SCRIPT= (.+)\n/;

        sendmsg( "Batch job id $jobid_submitted\nOutput directory $scratchdir_cluster_script\n", 0.06 );

        if ( !( $jobid_submitted > 0 ) ) {
            $ok = 0;
            sendmsg( "Invalid jobid\n", .98 );
        }

        if ( $jobid_submitted != $jobid_cluster_script ) {
            $ok = 0;
            sendmsg( "Job of $jobid_submitted does not match cluser script job id of $jobid_cluster_script\n", .98 );
        }

        if ( $ok ) {
            $jobid      = $jobid_submitted;
            $output_dir = $scratchdir_cluster_script;
        }
    }
}

if ( !$ok ) {
    $$res{ "note" } = "failure";
    print encode_json( $res ) . "\n";
    exit();
}

# start polling for qstat

my $running = 1;

my $qstat = "ssh $remotesys /usr/bin/qstat $jobid";
my $orgstat = '?';

while ( $running ) {
    print "qstat $qstat\n" if $debug;
    my @results = `$qstat 2>&1`;
    my @results = grep /^$jobid /, @results;
    my $stat = substr( $results[ 0 ], 62, 1 );
    print join "", @results if $debug;
    print "stat $stat\n" if $debug;
    if ( $stat ne $orgstat ) {
        my $ok   = 0;
        if ( $stat eq 'Q' ) {
            sendmsg( "Job status is queued\n", .1 );
            $ok = 1;
        }
        if ( $stat eq 'R' ) {
            sendmsg( "Job status is running\n", .15 );
            $ok = 1;
        }
        if ( $stat eq 'C' ) {
            sendmsg( "Job status is completed\n", .8 );
            $ok = 1;
            last;
        }
        if ( !$ok ) {
            sendmsg( "Job status is unknown ($stat)\n", .8 );
            $done = 1;
            last;
        }
    }
    $orgstat = $stat;
    sleep $queue_polling_seconds > 0 ? $queue_polling_seconds : 30;
}

# sleep $sleep_after_complete;

# setup to_get aa

{
    my %toget;

    foreach my $k ( @getresults ) {
        $toget{ $k }++;
    }

# check if they exist

    my $maxtries = $max_retries_for_output;
    my @results;
    my $sleeptime = $sleep_after_complete;
    my $retry_count = 0;
    while( $maxtries-- && scalar @results != @getresults ) {
        $sleeptime *= 2 if $sleeptime < $sleep_after_complete * 20;
        print "sleeping $sleeptime\n" if $debug;
        sleep $sleeptime;
        sendmsg( $retry_count ? "Retrieving results retry $retry_count\n" : "Retrieving results\n", 0.85 );
        $retry_count++;
        print "retry to get all data countdown from $maxtries\n" if $debug;

        my $checkall = '{' . ( join ',',@getresults ) . "}";

        my $cmd = "ssh $remotesys 'cd $output_dir; ls -1 $checkall' 2>/dev/null\n";
        print $cmd if $debug;
        @results = `$cmd`;
        grep chomp, @results;
    }

    print "failed to get all data within our tries\n" if $debug && scalar @results != @getresults;
    
    my $getem = '{' . ( join ',',@results ) . "}";
    if ( @results == 1 ) {
        $getem = join '',@results;
    }
        
    $cmd = "scp $remotesys:$output_dir/$getem . 2>&1 > /dev/null\n";
    
    print $cmd if $debug;

    my $results = `$cmd`;

    foreach my $k ( @results ) {
        delete $toget{ $k };
        my $id = $k;
        $id =~ s/(\W|_)//g;
        $$res{ $id } = $$ref{ "_base_directory" } . "/" .  $k;
    }

    my @missing;
    foreach my $k ( keys %toget ) {
        push @missing, $k;
    }

    if ( @missing ) {
        print "missing " . ( join ",", @missing ) . "\n" if $debug;
        $$res{ "Warning" } = "Missing results: " . ( join ",", @missing );
    }

    if ( !$toget{ 'spr_ell.mp4' } ) {
        sendmsg( "Converting video\n", .9 );
        $cmd = 
#            "ffmpeg -y -i spr_ell.mp4 -crf 18 spr_ell.webm > /dev/null 2>&1
            "ffmpeg -y -i spr_ell.mp4 -c:v libvpx -crf 18 -b:v 1M spr_ell_proc.webm > /dev/null 2>&1
ffmpeg -y -i spr_ell.mp4 -c:v libx264 -preset slow -pix_fmt yuv420p -b:v 1M -profile:v baseline -level 3.0 -c:a copy spr_ell_proc.mp4 > /dev/null 2>&1
";
#ffmpeg -y -i spr_ell.mpg -crf 18 spr_ell.mp4  > /dev/null 2>&1
#";
        `$cmd`;
        
        $$res{ "sprellmp4full" }  = $$ref{ "_base_directory" } . "/spr_ell.mp4";
        $$res{ "sprellmp4" }      = $$ref{ "_base_directory" } . "/spr_ell_proc.mp4";
        $$res{ "sprellwebm" }     = $$ref{ "_base_directory" } . "/spr_ell_proc.webm";
        $$res{ "sprellmpgvideo" } = $$ref{ "_base_directory" } . "/spr_ell_proc";
    }
    sendmsg( "Finished\n", 1 );
}

$$res{ "note" } = "flowinducedvibration executable";

