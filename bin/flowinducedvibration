#!/usr/bin/perl

$debug++;

# user definition area

my $remote = {};
$$remote{ "sys" } = "gridchem\@comet.sdsc.edu";
$$remote{ "userdir" } = "/home/gridchem/vortexshedding";
$$remote{ "stage" } = "/home/gridchem/vortexshedding";

my $maxruntime = "02:00";

# $$remote{ "genmap" }  = "/home/gridchem/bin/genmap";

$queue_polling_seconds  = 10;
$sleep_after_complete   = 15;
$max_retries_for_output = 5;

my @getresults = ( 
    'session.log',
    'spr_ell.map',
    'spr_ell.mp4' 
#    'spr_ell.mpg' 
    );

use JSON;
use Data::Dumper;
use IO::Socket;

if ( !@ARGV )
{
    print "\{\"error\":\"flowinducedvibration called with no arguments\"\}\n";
    exit;
}

my $ref = decode_json( shift );

$$remote{ "userdir" } .= "/" . $$ref{ "_logon" };
$$remote{ "stage" } .= "/" . $$ref{ "_logon" };

my $dir = $$ref{ "_base_directory" };

# setup input

my $re     = $$ref{"re"};
my $fnstar = $$ref{"fnstar"};
my $aa     = $$ref{"aa"};

$err = "";

$res = {};

## validate input

if ( !$re ) {
    $err .= "Reynolds Number not defined\n";
}

if ( !$fnstar ) {
    $err .= "Inverse Spring Constant not defined\n";
}

if ( !$aa ) {
    $err .= "Aspect Ratio not defined\n";
}

if ( length( $err ) ) {
    $$res{ "error" } = $err;
    print encode_json( $res ) . "\n";
    exit();
}

## messaging setup

my $domsg = $$ref{ "_uuid" } && $$ref{ "_udpport" } && $$ref{ "_udphost" };

my $sock;
$sock = IO::Socket::INET->new( Proto => 'udp', PeerPort => $$ref{ "_udpport" }, PeerAddr => $$ref{ "_udphost" } ) if $domsg;

sub sendmsg {
    return if !$domsg;
    my $text = $_[0];
    my $prog = $_[1];
    print "sendmsg: $prog $text\n" if $debug;

    if ( length( $text ) || length( $prog ) ) {
        my $msg  = {};
        $$msg{ "_uuid" } = $$ref{ "_uuid" };
        $$msg{ "_textarea" } = $text if length( $text );
        $$msg{ "_progress" } = $prog if length( $prog );
        $sock->send( encode_json( $msg ) );
    }
}

## format inputs for replacement
sub formatinput {
    my $x    = $_[0];
    my $dec  = $_[1];
    my $mlen = $_[2];
    my $fmt  = "\%.${mlen}f";
    my $out  = sprintf( $fmt, $x );
    $out = substr( $out, 0, $mlen );
    $out .= '0'x( $mlen - length( $out ) );
    $out;
}


my $f_re     = formatinput( $re,     4, 8 );
my $f_fnstar = formatinput( $fnstar, 4, 7 );
    
