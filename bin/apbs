		ion_charge = '1.0'
		ion_conc = '0.0'
		ion_radius = '1.62'
		manualflag = '0'
		manualfile = 'dum.txt'	
        	path='./'

        	#### END USER EDIT
        	#### END USER EDIT
        	#### END USER EDIT
       	else:
		runname = json_variables['runname']

		base_directory = json_variables['_base_directory']

        	path = base_directory.replace('\/','/') + "/"

		os.chdir(path)
