* GENERATED BY CHARMM-GUI (http://www.charmm-gui.org) v1.8 on Jun, 09. 2016.
* READ PDB, MANIPULATE STRUCTURE IF NEEDED, AND GENERATE TOPOLOGY FILE
*

DIMENS CHSIZE 2000000
!DIMENS CHSIZE 1000000

! Read topology and parameter files
stream toppar.str

! Read DNAA
open read card unit 10 name dnaa.pdb
read sequence pdb unit 10
generate DNAA setup warn first 5TER last 3TER

! DNA Chain Treatment
coor stat sele segid DNAA end
calc fres = ?selires
calc nres = ?nres

set k = @fres
label DNAAdeop
coor stat sele segid DNAA .and. ires @k end
set resname ?selresn
set kthresid = ?selresi
set patch deox ! for pyrimidine
if k .eq. @fres set patch = deo5
patch @patch DNAA @kthresid setup warn
autogenerate angles dihedrals
incr k by 1
if k .le. @nres goto DNAAdeop

open read form unit 10 name dnaa.pdb
read coor pdb unit 10

!open read card unit 10 name dnaa.pdb
!read coor pdb  unit 10 resid


! Read DNAB
open read card unit 10 name dnab.pdb
read sequence pdb unit 10
generate DNAB setup warn first 5TER last 3TER

! DNA Chain Treatment
coor stat sele segid DNAB end
calc fres = ?selires
calc nres = ?nres

set k = @fres
label DNABdeop
coor stat sele segid DNAB .and. ires @k end
set resname ?selresn
set kthresid = ?selresi
set patch deox ! for pyrimidine
if k .eq. @fres set patch = deo5
patch @patch DNAB @kthresid setup warn
autogenerate angles dihedrals
incr k by 1
if k .le. @nres goto DNABdeop

open read form unit 10 name dnab.pdb
read coor pdb unit 10 append

!open read card unit 10 name dnab.pdb
!read coor pdb  unit 10 resid


!Print heavy atoms with unknown coordinates
coor print sele ( .not. INIT ) .and. ( .not. hydrogen ) end

ic param
ic build
prnlev 0
hbuild sele hydr end
prnlev 5

ENERGY
! check if there are unknown coordinate
define XXX sele .not. INIT show end
if ?nsel .gt. 0 stop

open write card unit 10 name step1_pdbreader.pdb
write coor pdb  unit 10 official

open write card unit 10 name step1_pdbreader.crd
write coor unit 10 card

open write unit 10 card name step1_pdbreader.psf
write psf  unit 10 card

open write unit 10 card name step1_pdbreader.xplor_ext.psf
write psf  xplo unit 10 card

ioformat noext
open write unit 10 card name step1_pdbreader.xplor.psf
write psf  xplo unit 10 card


coor stat sele all end

calc cgtot = int ( ?cgtot )

open write unit 90 card name step1_pdbreader.str
write title unit 90
* set ncharge = @cgtot
* set xmax = ?xmax
* set ymax = ?ymax
* set zmax = ?zmax
* set xmin = ?xmin
* set ymin = ?ymin
* set zmin = ?zmin
*


stop