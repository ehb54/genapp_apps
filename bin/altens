		pdbfile=test_file_path + '1D3Z_mod1_new.pdb'
		residue_list_file = test_file_path + "reslist.txt"
		use_monte_carlo_flag = True
		number_of_monte_carlo_steps = '500' 
		seed = '1,123'	

		UDP_IP = '127.0.0.1'
		UDP_PORT = 5005

