        	path = base_directory.replace('\/','/') + "/"

		os.chdir(path)
		pdb_path = path

        	pdbfile = json_variables['pdbfile'][0]
		head,pdbfilename= os.path.split(pdbfile)

		path = ''

		UDP_IP = json_variables['_udphost']
