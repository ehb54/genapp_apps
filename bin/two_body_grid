class TwoBodyGrid_Drv():

   module = 'two_body_grid'

   def background_job(self,process,txtQueue):
        total_string = ''
        while process.is_alive():
                try:
                        this_text = txtQueue.get(True, timeout=0.1)
                        text_split=string.split(this_text)
                        if(text_split[0]=='STATUS'):
                                pass ; #progressBar.set(locale.atof(text_split[1]))
                        else:
                                total_string += this_text
                except:
                        if not process.is_alive():
                                return total_string
                time.sleep(0.01)
        else:
                return total_string

        return total_string

