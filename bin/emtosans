#!/share/apps/local/bin/python/bin/python
import json,sys,os,shutil
from StringIO import StringIO
import multiprocessing,time,string

import sassie.calculate.volumetobeads as volumetobeads
import sassie.interface.input_filter as input_filter

class Em_to_sans_Drv():

   module = 'emtosans'

   def background_job(self,process,txtQueue):
        total_string = ''
        while process.is_alive():
                try:
                        this_text = txtQueue.get(True, timeout=0.1)
                        text_split=string.split(this_text)
                        if(text_split[0]=='STATUS'):
                                pass ; #progressBar.set(locale.atof(text_split[1]))
                        else:
                                total_string += this_text
                except:
                        if not process.is_alive():
                                return total_string
                time.sleep(0.01)
        else:
                return total_string

        return total_string

   def read_file(self,flot_data,filename):

        try:
                data = [] ; error = []
                data_file = open(filename,'r').readlines()
                nl = len(data_file)

                for i in xrange(nl):
                        lin = string.split(data_file[i])
			if(lin[0] != '#'):
                        	this_x = lin[0]
                        	this_y = lin[1]
                	#       this_z = lin[2]
                        	data.append([this_x,this_y])
       			#       error.append([this_x,this_z])   

                flot_data.append(data)
                #flot_data.append(error)
                data_file.close()

        except:
                print 'ERROR READING INTERPOLATED DATA FILE'
                print 'ERROR READING INTERPOLATED DATA FILE'
                print 'ERROR READING INTERPOLATED DATA FILE'
                flot_data = "error reading file and making plot"

        return

   def get_data_from_disk(self,filename):

        flot_data = []

        self.read_file(flot_data,filename)

        return flot_data

   def run_me(self,json_flag,json_variables,input_string):

	output_dict = {}

	if not json_flag:

        	#### BEGIN USER EDIT
        	#### BEGIN USER EDIT
        	#### BEGIN USER EDIT

        	runname='run_0'
