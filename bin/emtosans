		threshold = '0.1'
		sansfile = 'p20a.sub'
		npoints = '100'
		qmax = '0.3'

        	path='./'

        	#### END USER EDIT
        	#### END USER EDIT
        	#### END USER EDIT
       	else:
		runname = json_variables['runname']
		
