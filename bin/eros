            sasintfiles = './K48_UBA2_org.dat'
            io = '0.1229'
            reduced_x2 = '1'
            plotflag = '0'

            path='./'

            data_path = path
            # END USER EDIT
            # END USER EDIT
            # END USER EDIT
        else:
            runname = json_variables['runname']
    
            base_directory = json_variables['_base_directory']

            path = base_directory.replace('\/','/') + "/"

            os.chdir(path)

