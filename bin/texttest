#!/usr/bin/perl

use JSON;
use Data::Dumper;
use IO::Socket;

if ( !@ARGV )
{
    print "\{\"error\":\"progtest called with no arguments\"\}\n";
    exit;
}

$ref = decode_json( shift );

my $sock = IO::Socket::INET->new( Proto => 'udp', PeerPort => $$ref{ "_udpport" }, PeerAddr => $$ref{ "_udphost" } );
my $msg = {};
$$msg{ "_uuid" } = $$ref{ "_uuid" };

$$msg{ "_progress" } = 0.0;
$$msg{ "progress" } = "progress is 0";
$sock->send( encode_json( $msg ) );

for ( my $i = .2; $i <= 2.1; $i += .1 )
{
    sleep 5;
    $$msg{ "_progress" } = $i;
    $$msg{ "progress" } = "progress is $i";
    $$msg{ "_textarea" } = "progress is $i\n";
    $sock->send( encode_json( $msg ) );
}

sleep 1;
my $res = {};
$$res{ "note" } = "progtest executable";

open OUT, ">>/tmp/log";
print OUT "-"x20 . "\n";
print OUT `date`;
print OUT "$0\n";
print OUT "--- input ---\n";
print OUT Dumper($ref);
print OUT "--- output ---\n";
print OUT Dumper($res);
print OUT "-"x20 . "\n";
close OUT;

print encode_json( $res ) . "\n";

