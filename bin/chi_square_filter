		x2highcut = '10.0'
		x2highweightfile = 'x2highweights.txt'
		x2lowcut = '1.0'
		x2lowweightfile = 'x2lowweights.txt'
		rghighcut = '60.0'
		rghighweightfile = 'rghighweights.txt'
		rglowcut = '40.0'
		rglowweightfile = 'rglowweights.txt'
		sastype = '1'
		reduced_x2 = '1'
		plotflag = '0'

		path='./'

                data_path = path
        	#### END USER EDIT
        	#### END USER EDIT
        	#### END USER EDIT
       	else:
		runname = json_variables['runname']
	
                base_directory = json_variables['_base_directory']

                path = base_directory.replace('\/','/') + "/"

                os.chdir(path)

                if(json_variables['data_list_box'] == "c1"):
                        temp_sasintfile = json_variables['sasintfile']
                        head, sasintfile = os.path.split(temp_sasintfile[0])
                elif(json_variables['data_list_box'] == "c2"):
                        sasintfile = json_variables['sasintfile_text']

                path = ''
	
                saspath = json_variables['saspath']
		saspath = saspath.replace('\/','/') + "/"
                io = json_variables['io']

                try:
                        advanced_input = json_variables['advanced_input']
