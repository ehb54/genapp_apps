#!/share/apps/local/bin/python/bin/python
import json,sys,os,shutil,time,math,locale
from StringIO import StringIO
import multiprocessing,time,string,socket

import sassie.analyze.best as best
import sassie.interface.input_filter as input_filter
import sassie.interface.best_filter as best_filter

class Chi_square_filter_Drv():

   module = 'filter'

   def message_box(self,text,icon):

        _message = {}
        _message['icon'] = icon
        _message['text'] = text

        UDP_IP = json_variables['_udphost']
        UDP_PORT = json_variables['_udpport']
        sock = socket.socket(socket.AF_INET, # Internet
                socket.SOCK_DGRAM) # UDP

        socket_dict={}
        socket_dict['_uuid'] = json_variables['_uuid']
        socket_dict['_message'] = _message

        doc_string = json.dumps(socket_dict)
        sock.sendto(doc_string,(UDP_IP,UDP_PORT))

        return

   def background_job(self,process,txtQueue,json_variables):

        total_string = ''

        UDP_IP = json_variables['_udphost']
        UDP_PORT = json_variables['_udpport']
        sock = socket.socket(socket.AF_INET, # Internet
                socket.SOCK_DGRAM) # UDP

        socket_dict={}
        socket_dict['_uuid'] = json_variables['_uuid']
        first = True

        while process.is_alive():
                try:
                        if(first):
                                socket_dict['progress_html'] = 0.01
                                socket_dict['progress_html'] = '<center>starting job</center>'
                                doc_string = json.dumps(socket_dict)
                                sock.sendto(doc_string,(UDP_IP,UDP_PORT))
                                first = False
                        this_text = txtQueue.get(True, timeout=0.1)
                        text_split=string.split(this_text)
                        if(text_split[0]=='STATUS'):
                                value = locale.atof(text_split[1])
                                svalue = str(100*value)
                                socket_dict['progress_output'] = value
                                socket_dict['progress_html'] = '<center>'+svalue+'</center>'
                                doc_string = json.dumps(socket_dict)
                                sock.sendto(doc_string,(UDP_IP,UDP_PORT))
                        else:
                                total_string += this_text
                except:
                        if not process.is_alive():

                                #doc_string = json.dumps(socket_dict)
                                #sock.sendto(doc_string,(UDP_IP,UDP_PORT))
                                return total_string

                time.sleep(0.01)
        else:
                return total_string

   def read_file(self,flot_data,filename,number_columns,this_pass):

        # sasfile: q-value, goal, best, worst, average

        value = 1

	log = False

	log_q = False

        #try:
        if True:
                data = [] ; error = []
                data_file = open(filename,'r').readlines()
                nl = len(data_file)

                for i in xrange(nl):
                        lin = string.split(data_file[i])
                        if(len(lin)>0):
                                if(lin[0][0] != "#" and this_pass < 5):
					if(locale.atof(lin[0]) > 0.0):
						if log_q:
                                        		this_x = str(math.log(locale.atof(lin[0]),10))
	                                        else:
							this_x = lin[0]
	                                        if(this_pass == 1):
							if log:
								this_y1 = str(math.log(locale.atof(lin[1]),10))
							else:
	                                                	this_y1 = lin[1]
	                                                data.append([this_x,this_y1])
	                                                legend = "goal"
	                                        elif(this_pass == 2):
							if log:
								this_y1 = str(math.log(locale.atof(lin[2]),10))
							else:
	                                                	this_y1 = lin[2]
	                                                data.append([this_x,this_y1])
	                                                legend = "best"
	                                        elif(this_pass == 3):
							if log:
								this_y1 = str(math.log(locale.atof(lin[3]),10))
							else:
	                                                	this_y1 = lin[3]
	                                                data.append([this_x,this_y1])
	                                                legend = "worst"
	                                        elif(this_pass == 4):
							if log:
								this_y1 = str(math.log(locale.atof(lin[4]),10))
							else:
	                                                	this_y1 = lin[4]
	                                                data.append([this_x,this_y1])
	                                                legend = "average"

                                elif(lin[0][0] != "#" and this_pass == 5):
                                        #this_x = locale.atof(lin[0])
                                        this_x = lin[0]
                                        #this_y1 = locale.atof(lin[4])
                                        this_y1 = lin[1]
                                        data.append([this_x,this_y1])

                if(this_pass == 5):

                        flot_dict = {
					#'lines' : { "show": "false" },
					'points' : { "show" : "true" },
                                        'color': 'yellow',
                                        'data': data
                                }
                        flot_data.append(flot_dict)

                elif(this_pass < 5):

                        flot_dict = {
                #                       'lines' : {lineWidth: 3},
                                        'label': legend,
                                        'data': data
                                }
                        flot_data.append(flot_dict)
                else:
                        flot_data.append(data)

        #except:
        #        print 'ERROR READING DATA FILE'
        #        print 'ERROR READING DATA FILE'
        #        print 'ERROR READING DATA FILE'
        #        flot_data = "error reading file and making plot"

        return value


   def get_data_from_disk(self,filename,number_columns):

	# sas_spectra_plot.txt 
# q-value, goal, best, worst, average
#0.000000	0.019000	0.019000	0.019000	0.019000

	# x2_versus_rg_plot.txt 
# Rg	X2
#63.749069	10.383249


        flot_data = []

        if(number_columns > 2):
                value = self.read_file(flot_data,filename,number_columns,1)
                value = self.read_file(flot_data,filename,number_columns,2)
                value = self.read_file(flot_data,filename,number_columns,3)
                value = self.read_file(flot_data,filename,number_columns,4)
        else:
                value = self.read_file(flot_data,filename,number_columns,5)

        return flot_data


   def run_me(self,json_flag,json_variables,input_string):

	output_dict = {}

	if not json_flag:

