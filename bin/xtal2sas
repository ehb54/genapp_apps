#!/share/apps/local/bin/python/bin/python
import json,sys,os,shutil
from StringIO import StringIO
import multiprocessing,time,string

import sassie.calculate.gxtal2sas as gxtal2sas
import sassie.interface.input_filter as input_filter

class Xtal2sas_Drv():

   module = 'xtal2sas'

   def background_job(self,process,txtQueue):
        total_string = ''
        while process.is_alive():
                try:
                        this_text = txtQueue.get(True, timeout=0.1)
                        text_split=string.split(this_text)
                        if(text_split[0]=='STATUS'):
                                pass ; #progressBar.set(locale.atof(text_split[1]))
                        else:
                                total_string += this_text
                except:
                        if not process.is_alive():
                                return total_string
                time.sleep(0.01)
        else:
                return total_string

        return total_string

   def run_me(self,json_flag,json_variables,input_string):

	output_dict = {}

	if not json_flag:

        	#### BEGIN USER EDIT
        	#### BEGIN USER EDIT
        	#### BEGIN USER EDIT

        	runname='run_0'
		dcdpath = './run_0/generate/'
		dcdfile = 'run_0.dcd'
		pdbpath = './run_0/generate/'
		pdbfile = 'c2.pdb'
		xtal2sasexe = '/share/apps/local/bin/xtal2sas.exe'
		delcaipfiles = '1'
		option = 'N'
		numiq = '50'
		qmax = '0.5'
		iomax = '1.0'
		numiter = '1'
		pd2O = '100.0'
		fhdexchange = '0.9'
		numhits = '1000'
		proteinhord = 'H'
	
		path='./'

        	#### END USER EDIT
        	#### END USER EDIT
        	#### END USER EDIT
       	else:
		runname = json_variables['runname']
		
		pdbpath = './'
		dcdpath = './'

                base_directory = json_variables['_base_directory']

                path = base_directory.replace('\/','/') + "/"

		pdbpath = path
		dcdpath = path

                os.chdir(path)

                if(json_variables['refpdb_list_box'] == "c1"):
                        temp_pdbfile = json_variables['pdbfile']
                        head, pdbfile = os.path.split(temp_pdbfile[0])
                elif(json_variables['refpdb_list_box'] == "c2"):
                        pdbfile = json_variables['pdbfile_text']

                if(json_variables['dcd_list_box'] == "c1"):
                        temp_dcdfile = json_variables['dcdfile']
                        head, dcdfile = os.path.split(temp_dcdfile[0])
                elif(json_variables['dcd_list_box'] == "c2"):
                        dcdfile = json_variables['dcdfile_text']

                path = ''



		numiq = json_variables['numiq']
