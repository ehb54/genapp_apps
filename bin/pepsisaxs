#!/usr/bin/perl

## user defines

# uncomment below to create a logfile
# $save_in_log = "/tmp/pepsisaxs.log";

# uncomment below to enable messaging
# $enable_msg = 1;

## end user defines

{
    if ( $] < 5.018 ) {
        my $f = "/etc/profile.d/genapp.sh";
        my $gb;
        if ( -e $f ) {
            my $fh;
            !open $fh, $f || die "Error: the version of perl found is < 5.18 and, although there exists $f, the permissions do now allow reading by this process\n";
            my @l = <$fh>;
            close $fh;
            @l = grep !/^\s*#/, @l;
            @l = grep /GENAPP=/, @l;
            grep chomp, @l;
            die "Error: the version of perl found is < 5.18 and, although there exists $f, there is no definition of GENAPP available within it.\n" if !@l;
            my $l = pop @l;
            ( $gb ) = $l =~ /GENAPP=([^#;]+)/;
            die "Error: the version of perl found is < 5.18 and, although there exists $f, the value of GENAPP within it could not be parsed.\n" if !$gb;
            die "Error: the version of perl found is < 5.18 and, although there exists $f, the value of GENAPP within it ($gb) is not a directory.\n" if !-d $gb;
        } else {
            die "Error: the version of perl found is < 5.18 and $f does not exist\n";
        }        
        if ( -e "$gb/perl/bin/perl" ) {
            $pv =`$gb/perl/bin/perl -e 'print \$];'`;
            if ( $pv >= 5.018 ) {
                unshift @ARGV, $0;
                exec( "$gb/perl/bin/perl", @ARGV );
            } else {
                die "$gb/perl/bin/perl exists, but not a correct version of perl (needs a minimum of 5.18)\n";
            }
        } else {
            die "you need to install a version of perl >= 5.18 in $gb/perl\n
there is a script $gb/sbin/install-perl-stable to do this";
        }
    }
}

my $rc = eval {
    require JSON;         JSON->import();
};

if ( !@ARGV )
{
    print "\{\"error\":\"pepsisaxs called with no arguments\"\}\n";
    exit;
}

$ref = decode_json( shift );

## messaging setup

sub sendmsg {};

if ( $enable_msg ) {
    
    my $rc = eval {
        require IO::Socket;   IO::Socket->import();
    };

    my $domsg = $$ref{ "_uuid" } && $$ref{ "_udpport" } && $$ref{ "_udphost" };

    my $sock;
    $sock = IO::Socket::INET->new( Proto => 'udp', PeerPort => $$ref{ "_udpport" }, PeerAddr => $$ref{ "_udphost" } ) if $domsg;

    sub sendmsg {
        return if !$domsg;
        my $text = $_[0];
        my $prog = $_[1];
        print "sendmsg: $prog $text\n" if $debug;

        if ( length( $text ) || length( $prog ) ) {
            my $msg  = {};
            $$msg{ "_uuid" } = $$ref{ "_uuid" };
            $$msg{ "_textarea" } = $text if length( $text );
            $$msg{ "_progress" } = $prog if length( $prog );
            $sock->send( encode_json( $msg ) );
        }
    }
}


## format inputs for replacement
sub formatinput {
    my $x    = $_[0];
    my $dec  = $_[1];
    my $mlen = $_[2];
    my $fmt  = "\%.${mlen}f";
    my $out  = sprintf( $fmt, $x );
    $out = substr( $out, 0, $mlen );
    $out .= '0'x( $mlen - length( $out ) );
    $out;
}

$res = {};

# assemble output

$pwd = `pwd`;
chomp $pwd;

if ( !$$ref{'pdb'}[0] ) {
    $$res{ "error" } = "No pdb specified!";
    print encode_json( $res ) . "\n";
    exit;
}
    
# fix up paths

#$$ref{'pdb'}[0] =~ s/^.*\/([^\/]*$)/\1/;
#$$ref{'experimental_curve'}[0] =~ s/^.*\/([^\/]*$)/\1/;

# build cmd

$cmdpath = $0;
$cmdpath =~ s/\/[^\/]*$/\/Pepsi-SAXS/;

$cmd = "$cmdpath $$ref{'pdb'}[0]";
$cmd .= " $$ref{'experimental_curve'}[0]" if $$ref{'experimental_curve'}[0];
$cmd .= " -n $$ref{'expansion_order'}" if $$ref{'setexpansion_order'};
$cmd .= " -au $$ref{'au'}" if $$ref{'au'} != 0;
$cmd .= " -ns $$ref{'ns'}" if !$$ref{'experimental_curve'};
$cmd .= " -ms $$ref{'ms'}" if !$$ref{'experimental_curve'};
$cmd .= " -cst" if $$ref{'cst'};
$cmd .= " --neg" if $$ref{'neg'};
$cmd .= " --hyd" if $$ref{'hyd'};
$cmd .= " -fast" if $$ref{'fast'};
$cmd .= " --noSmearing" if $$ref{'noSmearing'};
$cmd .= " --dro $$ref{'dro'}" if $$ref{'manualdro'};
$cmd .= " --fluc" if $$ref{'fluc'};
$cmd .= " --modes $$ref{'modes'}" if $$ref{'manualmodes'};
$cmd .= " --covScaling $$ref{'covScaling'}" if $$ref{'manualcovScaling'};
$cmd .= " --cutoff $$ref{'c'}" if $$ref{'manualc'};

$cmd .= " 2>stderr.txt";

@cmdresults = `$cmd`;
$cmdresults = join '', @cmdresults;
$cmdresults .= "-"x80 . "\n" . `ls -l` if $debug;
$$res{ "_textarea" } = $cmdresults;

@output = grep /Output file name/, @cmdresults;
$$res{'outfile'} = $output[0] if @output;
$$res{'outfile'} =~ s/^.[^:]*: //;

# logfile

$logfile = $$res{'outfile'};
$logfile =~ s/\.[^\.]*$/.log/;
open OUT, ">$logfile";
print OUT $cmdresults;
close OUT;

# add basedir

$$res{'logfile'} = "$$ref{'_base_directory'}/$logfile";
$$res{'outfile'} = "$$ref{'_base_directory'}/$$res{'outfile'}";

open IN, "stderr.txt";
@err = <IN>;
close IN;
if ( @err ) {
    $$res{ "errors" } = join '', @err;
}

if ( $debug ) {
    $$res{ "note" } = "pepsisaxs executable";
    $$res{ "pwd" } = $pwd;
    $$res{ "me" } = $0;
    $$res{ "json" } = encode_json($ref);
}

$$res{ "cmd" } = $cmd if $debugcmd;

if ( length( $save_in_log ) ) {
    my $rc = eval {
        require Data::Dumper;;   Data::Dumper->import();
    };

    open OUT, ">>$save_in_log";
    print OUT "-"x20 . "\n";
    print OUT `date`;
    print OUT "$0\n";
    print OUT "--- input ---\n";
    print OUT Dumper($ref);
    print OUT "--- output ---\n";
    print OUT Dumper($res);
    print OUT "-"x20 . "\n";
    close OUT;
}

print encode_json( $res ) . "\n";

