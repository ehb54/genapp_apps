"0.0001457"], ["0.3978", "-0.0008477"], ["0.4011", "-0.0001244"], ["0.4044", "0.0002944"], ["0.4077", "-0.0003043"], ["0.4109", "-0.0004642"], ["0.4142", "0.0005972"], ["0.4175", "-0.001228"], ["0.4207", "0.001525"], ["0.424", "0.000802"], ["0.4272", "0.0002"], ["0.4305", "-0.003276"]], "points": {"radius": "1", "show": "true"}, "lines": {"lineWidth": "1.0", "show": "true"}, "label": "original data"}], "options": {"xscale": "log", "ymin":"1e-5","ymax":"1.5e-2","ylabel": "I(q)", "xlabel": "q (1/angstrom)", "yscale": "log", "title": "Results"}}}';

open OUT, ">$p/logref.txt";
print OUT Dumper($ref);
close OUT;
open OUT, ">$p/logres.txt";
print OUT Dumper($res);
print OUT "--- as json output string ---\n";
print OUT $json;
close OUT;

# print "$json\n";
print "$ugplot4\n";
