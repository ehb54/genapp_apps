                  "label"    : "Temperature (C): ",
                  "type"     : "text",
                  "default"  : "20.00",
                  "required" : "true",
                  "help" : "temperature (in Celsius, C)",
                  "repeat"  : "hydro_options"
                },	

	        {
                    "role"    : "input",
                    "id"      : "bead_model_options",
                    "label"    : "Bead Model Options",
                    "type"    : "checkbox",
                    "checked" : "false",
                    "help"    : "set options controlling the bead model generation",
                    "repeater"  : "true" 
