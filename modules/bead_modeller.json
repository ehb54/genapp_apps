	       {
                    "role"    : "input",
                    "id"      : "miscellaneous_options",
                    "label"    : "Miscellaneous Options",
                    "type"    : "checkbox",
                    "checked" : "false",
                    "help"    : "set some options affecting both the model building and the hydrodynamic computations stages",
                    "repeater"  : "true"
                  #  "repeat"  : "advanced_input"		   
	         },

              {
                    "role"     : "input",
                    "id"       : "hydr_water_vol",
                    "label"    : "Hydration Water Vol. (A^3):",
                    "type"     : "text",
                    "default"  : "24.041",
                    "help"     : "set the volume of the water of hydration molecules (found to be on average 24.5 A^3, different from that of either bulk, 29.7 A^3, or isolated water molecules, 11.5 A^3)",
                    "required" : "true",
		    "repeat" : "miscellaneous_options"
                 },		

               {
		    "role"    : "input",
                    "id"      : "vbar_options",
                    "label"    : "Vbar Options",
		    "type"    : "listbox",
		    "values"  : "Calculate vbar~c1~Enter vbar and temperature values~c2",
		    "default" : "c1", 
                    "repeater"  : "true",
                    "help"    : "Calculate_vbar option allows the computation of the partial specific volume (vbar) in standard conditions (water at 20C) of the structure from its composition, using the residues values stored in the residue table. Alternatively, a vbar value (either computed by other means or measured) and the corresponding temperaure can be entered",
		    "repeat"  : "miscellaneous_options"
                 },

                {
                    "role"     : "input",
                    "id"       : "entered_vbar_value",
                    "label"    : "Vbar value:",
