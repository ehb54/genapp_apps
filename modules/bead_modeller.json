# this is a module file, any module specific info belongs here
{
    "moduleid" : "bead_modeller",
    "label"    : "Bead Modeller/Hydrodynamic Calculations",
    "help"     : "help for Bead Modeller",
    "fields"   : [
	          {
                   "role"      : "input",
                   "id"      : "hydro",
                   #"label"   : "ON for HYDRO module",
                   "type"    : "hidden",
                   #"checked"  : "true",
                   #"required" :  "true"
		   "default" : "on"
                   },	

                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "Input PDB file",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "structural PDB file with the model(s) to process"
                   },
                  {
                   "role"     : "input",
                   "id"       : "first_model",
                   "label"    : "Process only 1st model",
		   "checked"  : "true",  
                   "type"     : "checkbox",
	           "help"     : "the first model in the list of PDB models will be processed"
                   },

#####################################################################

                {
		    "role"    : "input",
		    "id"      : "bead_model_list_box",
		    "name"    : "bead_model_list_box",
		    "label"    : "Bead Model",
		    "type"    : "listbox",
		    "values"  : "AtoB (Grid)~atob~SOMO~somo~SOMO overlap~somo_o",
		    "default" : "atob",
		    "repeater" : "yes",
		    "help"     : "choose the method for bead model creation"
		},

	       {
                    "role"     : "input",
                    "id"       : "cube_side",
                    "label"    : "Cube Side (Angstrom): ",
                    "type"     : "text",
                    "default"  : "5",
                    "required" : "true",
                    "help" : "set the dimension of the grid cubelets",
                    "repeat"  : "bead_model_list_box:atob"
                },	

               {
		    "role"     : "input",
		    "id"       : "atob_list_box",
		    "label"    : "Hydrodynamic Method",
		    "type"     : "listbox",
		    "values"  : "SMI~smi~Zeno~zeno~None~none",
		    "default"  : "smi",
		    "help"  : "select method for hydrodynamoc calculations",
		    "repeat" : "bead_model_list_box:atob",
		    "repeater" : "true",
		    "required" : "true"
		},
 	      {
                    "role"     : "input",
                    "id"       : "zeno_steps_atob",
                    "label"    : "Zeno Steps (thousands): ",
                    "type"     : "text",
                    "default"  : "1000",
                    "required" : "true",
                    "help" : "number of steps for Zeno method",
                    "repeat"  : "atob_list_box:zeno"
                },	

              {
		    "role"     : "input",
		    "id"       : "somo_list_box",
		    "label"    : "Hydrodynamic Method",
		    "type"     : "listbox",
		    "values"  : "SMI~smi~Zeno~zeno~None~none",
		    "default"  : "smi",
		    "help"  : "select method for hydrodynamoc calculations",
		    "repeat" : "bead_model_list_box:somo",
		    "repeater" : "true",
		    "required" : "true"
		},

	      {
                    "role"     : "input",
                    "id"       : "zeno_steps_somo",
                    "label"    : "Zeno Steps (thousands): ",
                    "type"     : "text",
                    "default"  : "1000",
                    "required" : "true",
                    "help" : "number of steps for Zeno method",
                    "repeat"  : "somo_list_box:zeno"
                },		

              {
		    "role"     : "input",
		    "id"       : "somo_o_list_box",
		    "label"    : "Hydrodynamic Method",
		    "type"     : "listbox",
		    "values"  : "Zeno~zeno~None~none",
		    "default"  : "zeno",
		    "help"  : "select method for hydrodynamoc calculations",
		    "repeat" : "bead_model_list_box:somo_o",
		    "repeater" : "true",
		    "required" : "true"
		},
	      {
                    "role"     : "input",
                    "id"       : "zeno_steps_somo_o",
                    "label"    : "Zeno Steps (thousands): ",
                    "type"     : "text",
                    "default"  : "1000",
                    "required" : "true",
                    "help" : "number of steps for Zeno method",
                    "repeat"  : "somo_o_list_box:zeno"
                },		

	     
                  {
                   "role"     : "input",
                   "id"       : "show_atomistic_model",
