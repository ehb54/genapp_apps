# this is a module file, any module specific info belongs here
{
    "moduleid" : "emtosans",
    "label"    : "EM to SANS",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "EM to SANS",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called emtosans/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "emfiletype_list_box",
                   "name"    : "emfiletype_list_box",
                   "label"   : "select EM file type",
                   "type"    : "listbox",
                   "values"  : "mrc~c1~Gaussian cube~c2",
                   "default" : "c2"
                   },
                  {
                   "role"    : "input",
                   "id"      : "emfile_list_box",
                   "name"    : "emfile_list_box",
                   "label"    : "input EM density file",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"       : "emdensityfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of file with EM density data",
                   "repeat"   : "emfile_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "emdensityfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of file with EM density data",
                   "repeat"   : "emfile_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "angpix",
                   "label"    : "mrc angstroms/pixel resolution (x,y,z)",
                   "type"     : "text",
		   "default"  : "20.0,20.0,20.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "ouput file name (pdb)",
                   "type"     : "text",
                   "default"  : "p20a.pdb",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "threshold",
                   "label"    : "cutoff threshold",
                   "type"     : "text",
                   "default"  : "0.1",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sansfile",
                   "label"    : "output SANS profile file name",
                   "type"     : "text",
                   "default"  : "p20a.sub",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "npoints",
                   "label"    : "number of q points in SANS profile",
                   "type"     : "text",
                   "default"  : "100",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "qmax",
                   "label"    : "maximum q in SANS profile",
                   "type"     : "text",
                   "default"  : "0.3",
                   "required" : "true"
                   },
                  {
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0
                   },
                  {
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   },
                   {
                   "role"    : "output",
                   "id"      : "pr_plot",
                   "label"   : "pr",
                   "type"    : "plot2d"
                   },
                   {
                   "role"    : "output",
                   "id"      : "iq_plot",
                   "label"   : "iq",
                   "type"    : "plot2d"
                   },
 		  {
                   "role"    : "output",
                   "id"      : "sasoutput2",
                   "name"    : "sasoutput2",
                   "label"   : " ",
                   "type"    : "textarea",
		   "rows"    : 20,
		   "cols"    : 80
		   }
                  ],
    "executable" : "emtosans"
}
