# this is a module file, any module specific info belongs here
{
    "moduleid" : "emtosans",
    "label"    : "EM to SANS",
    "fields"   : [
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "project name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "emfiletype_list_box",
                   "name"    : "emfiletype_list_box",
                   "label"   : "select EM file type",
                   "type"    : "listbox",
                   "values"  : "mrc~c1~Gaussian cube~c2",
                   "default" : "mrc"
                   },
                  {
                   "role"     : "input",
                   "id"       : "emdensityfile",
                   "label"    : "input EM density file",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "angpix",
                   "label"    : "mrc angstroms/pixel resolution (x,y,z)",
                   "type"     : "text",
		   "default"  : "20.0,20.0,20.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "ouput file name (pdb)",
                   "type"     : "text",
                   "default"  : "p20a.pdb",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "threshold",
                   "label"    : "cutoff threshold",
                   "type"     : "text",
                   "default"  : "0.1",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sansfile",
                   "label"    : "output SANS profile file name",
                   "type"     : "text",
                   "default"  : "p20a.sub",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "npoints",
                   "label"    : "number of q points in SANS profile",
                   "type"     : "text",
                   "default"  : "100",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "qmax",
                   "label"    : "maximum q in SANS profile",
                   "type"     : "text",
                   "default"  : "0.3",
                   "required" : "true"
                   },
                   {
                   "role"    : "output",
                   "id"      : "pr_plot",
                   "label"   : "pr",
                   "type"    : "plot2d"
                   },
                   {
                   "role"    : "output",
                   "id"      : "iq_plot",
                   "label"   : "iq",
                   "type"    : "plot2d"
                   },
 		  {
                   "role"    : "output",
                   "id"      : "sasoutput2",
                   "name"    : "sasoutput2",
                   "label"   : " ",
                   "type"    : "textarea",
		   "rows"    : 20,
		   "cols"    : 80
		   }
                  ],
    "executable" : "emtosans"
}
