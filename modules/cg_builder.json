# this is a module file, any module specific info belongs here
{
    "moduleid" : "cg_builder",
    "label"    : "CG Builder",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "CG Builder",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called cg_builder/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "pdb file input",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                   {
                   "role"    : "output",
                   "id"    : "outputpdb",
                   "label" : "viewer (right click for options)",
                   "type"  : "atomicstructure",
                   "height" : "500",
                   "width" : "500"
                   },
                  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
                    "rows"    : 20,
                    "cols"    : 80
                   }
                  ],
# the executable will take inputs in order and produce output
    "executable" : "cg_builder"
}
