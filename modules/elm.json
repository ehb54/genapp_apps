# this is a module file, any module specific info belongs here
{
    "moduleid" : "elm",
    "label"    : "Calculate",
    #"resource" : "oscluster",
    "submitpolicy" : "login",
    #"help"     : "help for Bead Modeller",
    #"center"   : "true",
    #"centeroutput" : "true",
    #"notify"    : "alexsav.science@gmail.com",
    "notify" : "email",

    
    "fields"   : [
                {   
                   "role"     : "input",  
                   "id"       : "ELM_label",
                   "label"    : "Diffusion Tensor Prediction (ELM)",
                   "type"     : "label",
                   "prehline" : "true",
                   "posthline": "true",
                   "default"  : "header4"
               },  
               {
	            "role"       : "input"
	            ,"id"         : "projectname"
	            ,"label"      : "Project name"
	            ,"type"       : "text"
	            ,"required"   : "true"
	            ,"help"       : "Enter a project name"
	            ,"specifiedproject" : "Run_"
	        },
################################################################
	       { 
		   "role"     : "input",  
		   "id"       : "data_label",
		   "label"    : "DATA",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },
                  {
                   "role"     : "input",
                   "id"       : "pdb_location",
                   "label"    : "PDB File",
                   "type"     : "lrfile",
                   "required" : "true",
		   "accept"   : ".pdb",
		   "help"     : "Upload PDB file"
                   },
               {   
                   "role"    : "input",
                   "id"      : "model",
                   "label"   : "PDB File model",
                   "type"    : "text",
                   "required" : "True",
                   "default" : "1"
               },
	       { 
		   "role"     : "input",  
		   "id"       : "runmenu_label",
		   "label"    : "RUN MENU",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },
            {
                "role"    : "input",
                "id"      : "temperature",
                "label"   : "temperature(K)",
                "type"    : "text",
                "required" : "True",
                "default" : "298"
            },
            {
	        "role"     : "input",
	        "id"       : "adv_option",
	        "label"    : "check box to enable advanced model",
	        "type"     : "checkbox",
	        "checked"  : "false",
	        "repeater" : "true"
	    },
            {   
                "role"    : "input",
                "id"      : "hydro",
                "label"   : "hydration layer thickness(Angstrom)",
                "type"    : "text",
                "required" : "True",
                "default" : "2.2",
                "repeat": "adv_option"
            },
            {   
                "role"    : "input",
                "id"      : "water",
                "label"   : "water radius(Angstrom)",
                "type"    : "text",
                "required" : "True",
                "default" : "1.4",
                "repeat" : "adv_option"
            },  
 #####################################################################################################
                 {
		     "role"    : "output",
		     "id"      : "progress_output",
		     "label"   : "Progress: ",
		     "type"    : "progress",
		     "max"     : 1.0
		 },	
                {
		   "role"    : "output",
                   "id"      : "progress_text",
                   "label"   : "Calculation Report: ",
		   "type"    : "textarea",
                   #"append"  : "on",
                   "cols"    : 40
                  },  
                   {   
                   "role"  : "output",
                   "id"    : "elm_out",
                   "label" : "Download ELM prediction",
                   "type"  : "file",
                   "multiple": "true"
                  }
            ],

# the executable will take inputs in order and produce output
    "executable" : "main_elm.py"
}
