# this is a module file, any module specific info belongs here
{
    "moduleid" : "merge_utilities",
    "label"    : "Merge Utilities",
    "fields"   : [
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "project name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdb_file",
                   "label"    : "reference pdb",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "merge_option_list_box",
                   "name"    : "merge_option_list_box",
                   "label"   : "select option",
                   "type"    : "listbox",
                   "values"  : "merge dcd & sas~c1~merge sas only~c2",
                   "default" : "merge dcd & sas"
                   },
                  {
                   "role"     : "input",
                   "id"       : "run_paths",
                   "label"    : "project name paths",
                   "type"     : "text",
		   "default"  : "run_m1,run_m2",
                   "required" : "true"
	           },
                  {
                   "role"     : "input",
                   "id"       : "dcd_names",
                   "label"    : "dcd filenames",
                   "type"     : "text",
		   "default"  : "generate/run_m1.dcd,generate/run_m2.dcd",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "sas_type_list_box",
                   "name"    : "sas_type_list_box",
                   "label"   : "select SAS type",
                   "type"    : "listbox",
                   "values"  : "xtal2sas~c1~cryson~c2~crysol~c3",
                   "default" : "xtal2sas"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sas_paths",
                   "label"    : "sas path",
                   "type"     : "text",
                   "default"  : "xtal2sas",
                   "required" : "true"
                   },
                   {
                   "role"  : "output",
                   "id"    : "sasoutput1",
                   "label" : "Output value 1",
                   "type"  : "text"
                   },
		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : "run output",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "merge_utilities"
}
