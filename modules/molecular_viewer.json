# this is a module file, any module specific info belongs here
{
    "moduleid" : "molecular_viewer",
    "label"    : "Molecular Viewer",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Molecular Viewer",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "reference pdb",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
		   "safefile" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "output",
                   "id"    : "outputpdb",
                   "label" : "viewer (right click for options)", 
                   "type"  : "atomicstructure",
                   "height" : "600",
                   "width" : "600"
                   }
                  ],
# the executable will take inputs in order and produce output
    "executable" : "molecular_viewer"
}
