# this is a module file, any module specific info belongs here
{
    "moduleid" : "xtal2sas",
    "label"    : "Xtal2sas",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Xtal2sas",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called xtal2sas/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "reference pdb",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcd_list_box",
                   "name"    : "dcd_list_box",
                   "label"   : "input filename (dcd or pdb)",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcdfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to calculate SANS",
                   "repeat"   : "dcd_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcdfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to calculate SANS",
                   "repeat"   : "dcd_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numiq",
                   "label"    : "number of I(Q) values",
                   "type"     : "text",
                   "default"  : "50",
                   "help" : "enter the number ; note that to filter predicted data the number of q-values and range must be consistent with interpolated data",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "qmax",
                   "label"    : "maximum Q value",
                   "type"     : "text",
                   "default"  : "0.5",
                   "help" : "(1/angstrom)",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "iomax",
                   "label"    : "intensity at I(0)",
                   "type"     : "text",
                   "default"  : "1.0",
                   "help" : "experimentally determined value of I(0): usually determined by Guinier analysis",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numiter",
                   "label"    : "number of iterations",
                   "type"     : "text",
                   "default"  : "1",
                   "help"  : "usually 1 is adequate",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numhits",
                   "label"    : "number of hits",
                   "type"     : "text",
                   "default"  : "1000",
                   "help"  : "number of Monte Carlo steps to estimate scattering",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pd2O",
                   "label"    : "percent solvent D2O",
                   "type"     : "text",
                   "default"  : "100.0",
                   "help"  : "enter a value between 0.0 and 100.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fhdexchange",
                   "label"    : "fraction H-D exchange",
                   "type"     : "text",
                   "default"  : "0.9",
                   "help"  : "enter a value between 0.0 and 1.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "proteinhord_list_box",
                   "name"    : "proteinhord_list_box",
                   "label"   : "protein protonated or deuterated",
                   "type"    : "listbox",
                   "values"  : "H~c1~D~c2",
                   "default" : "c1",
                   "help" : "pick an option describe deuteration state"
                   },
                  {
                   "role"    : "input",
                   "id"      : "delcaipfiles_list_box",
                   "name"    : "delcaipfiles_list_box",
                   "label"   : "delete crd/ans/inf/pr files",
                   "type"    : "listbox",
                   "values"  : "yes~c1~no~c2",
                   "default" : "c1",
                   "help" : "useful to keep these files for further analysis and debugging"
                   },
                  {
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0
                   },
                  {
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "xtal2sas"
}
