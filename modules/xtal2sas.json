# this is a module file, any module specific info belongs here
{
    "moduleid" : "xtal2sas",
    "label"    : "Xtal2sas",
    "fields"   : [
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "project name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "pdb reference file name",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile",
                   "label"    : "trajectory file name (pdb or dcd)",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numiq",
                   "label"    : "number of I(Q) values",
                   "type"     : "text",
                   "default"  : "50",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "qmax",
                   "label"    : "maximum Q value",
                   "type"     : "text",
                   "default"  : "0.5",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "iomax",
                   "label"    : "intensity at I(0)",
                   "type"     : "text",
                   "default"  : "1.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numiter",
                   "label"    : "number of iterations",
                   "type"     : "text",
                   "default"  : "1",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numhits",
                   "label"    : "number of hits",
                   "type"     : "text",
                   "default"  : "1000",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pd2O",
                   "label"    : "percent solvent D2O",
                   "type"     : "text",
                   "default"  : "100.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fhdexchange",
                   "label"    : "fraction H-D exchange",
                   "type"     : "text",
                   "default"  : "0.9",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "proteinhord_list_box",
                   "name"    : "proteinhord_list_box",
                   "label"   : "protein protonated or deuterated",
                   "type"    : "listbox",
                   "values"  : "H~c1~D~c2",
                   "default" : "H"
                   },
                  {
                   "role"    : "input",
                   "id"      : "delcaipfiles_list_box",
                   "name"    : "delcaipfiles_list_box",
                   "label"   : "delete crd/ans/inf/pr files",
                   "type"    : "listbox",
                   "values"  : "yes~c1~no~c2",
                   "default" : "yes"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : "run output",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "xtal2sas"
}
