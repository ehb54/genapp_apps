# this is a module file, any module specific info belongs here
{
    "moduleid" : "structure_minimization",
    "label"    : "Structure Minimization",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Structure Minimization",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"       : "input",
                   "id"         : "runname",
                   "label"      : "run name",
                   "type"       : "text",
                   "default"    : "run_0",
                   "required"   : "true",
                   "help"     : "results will be placed in a folder called minimization/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "reference pdb",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcd_list_box",
                   "name"    : "dcd_list_box",
                   "label"   : "input filename (dcd or pdb)",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to energy minimize",
                   "repeat"   : "dcd_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to energy minimize",
                   "repeat"   : "dcd_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "psf_list_box",
                   "name"    : "psf_list_box",
                   "label"   : "charmm PSF file name",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "psffile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PSF file with molecular topology",
                   "repeat"   : "psf_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "psffile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of PSF file with molecular topology",
                   "repeat"   : "psf_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "outfile",
                   "label"   : "output file name (dcd)",
                   "type"    : "text",
                   "default" : "min_run_0.dcd",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "nsteps",
                   "label"   : "number of minimization steps",
                   "type"    : "text",
                   "default" : "100",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "ncpu",
                   "label"   : "number of processors",
                   "type"    : "text",
                   "default" : "1",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "keepout_list_box",
                   "name"    : "keepout_list_box",
                   "label"    : "keep run output files",
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "c1"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcdfreq",
                   "label"   : "DCD write frequency",
                   "type"    : "text",
                   "default" : "20",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "md_list_box",
                   "name"    : "md_list_box",
                   "label"   : "run type",
                   "type"    : "listbox",
                   "values"  : "minimization~c1~minimization / md~c2~minimization / md / minimization~c3",
                   "default" : "c1"
                   },
                  {
                   "role"    : "input",
                   "id"      : "mdsteps",
                   "label"   : "number md timesteps (1 step = 2 fs)",
                   "type"    : "text",
                   "default" : "10000",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dielect",
                   "label"   : "solvent dielectric",
                   "type"    : "text",
                   "default" : "1.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "temperature",
                   "label"   : "temperature (K)",
                   "type"    : "text",
                   "default" : "300.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0
                   },
                  {
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   },
		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
                   }
                  ],
# the executable will take inputs in json and produce output in json
    "executable" : "structure_minimization"
}
