# this is a module file, any module specific info belongs here
{
    "moduleid" : "structure_minimization",
    "label"    : "Structure Minimization",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Structure Minimization",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"       : "input",
                   "id"         : "runname",
                   "label"      : "run name",
                   "type"       : "text",
                   "default"    : "run_0",
                   "required"   : "true",
                   "help"     : "results will be placed in a folder called minimization/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile",
                   "label"   : "input file name (pdb)",
                   "type"    : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile",
                   "label"   : "input file name (dcd or pdb)",
                   "type"    : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "psffile",
                   "label"   : "charmm PSF filename",
                   "type"    : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "outfile",
                   "label"   : "output file name (dcd)",
                   "type"    : "text",
                   "default" : "run_0/minimization/min_run_0.dcd",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "nsteps",
                   "label"   : "number of minimization steps",
                   "type"    : "text",
                   "default" : "100",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "ncpu",
                   "label"   : "number of processors",
                   "type"    : "text",
                   "default" : "1",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "keepout_list_box",
                   "name"    : "keepout_list_box",
                   "label"    : "keep run output files",
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "c1"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcdfreq",
                   "label"   : "DCD write frequency",
                   "type"    : "text",
                   "default" : "20",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "md_list_box",
                   "name"    : "md_list_box",
                   "label"   : "run type",
                   "type"    : "listbox",
                   "values"  : "minimization~c1~minimization / md~c2~minimization / md / minimization~c3",
                   "default" : "c1"
                   },
                  {
                   "role"    : "input",
                   "id"      : "mdsteps",
                   "label"   : "number md timesteps (1 step = 2 fs)",
                   "type"    : "text",
                   "default" : "10000",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dielect",
                   "label"   : "solvent dielectric",
                   "type"    : "text",
                   "default" : "1.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "temperature",
                   "label"   : "temperature (K)",
                   "type"    : "text",
                   "default" : "300.0",
                   "required" : "true"
                   },
		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
                   }
                  ],
# the executable will take inputs in json and produce output in json
    "executable" : "structure_minimization"
}
