# this is a module file, any module specific info belongs here
{
    "moduleid" : "chi_square_filter",
    "label"    : "Chi-Square Filter",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Chi-Square Filter",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "saspath",
                   "label"    : "path to SAS files",
                   "type"     : "text",
                   "default"  : "run_0/xtal2sas/",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sasintfile",
                   "label"    : "SAS exp. data file (goal)",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "io",
                   "label"    : "I(0)",
                   "type"     : "text",
                   "default"  : "0.019",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "x2highcut",
                   "label"    : "X2 high cutoff",
                   "type"     : "text",
		   "default"  : "10.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "x2highweightfile",
                   "label"    : "X2 high cutoff file (output)",
                   "type"     : "text",
                   "default"  : "x2highweights.txt",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "x2lowcut",
                   "label"    : "X2 low cutoff",
                   "type"     : "text",
		   "default"  : "1.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "x2lowweightfile",
                   "label"    : "X2 low cutoff file (output)",
                   "type"     : "text",
                   "default"  : "x2lowweights.txt",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rghighcut",
                   "label"    : "Rg high cutoff",
                   "type"     : "text",
		   "default"  : "60.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rghighweightfile",
                   "label"    : "Rg high cutoff file (output)",
                   "type"     : "text",
                   "default"  : "rghighweights.txt",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rglowcut",
                   "label"    : "Rg low cutoff",
                   "type"     : "text",
		   "default"  : "40.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rglowweightfile",
                   "label"    : "Rg low cutoff file (output)",
                   "type"     : "text",
                   "default"  : "rglowweights.txt",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "sastype_list_box",
                   "name"    : "sastype_list_box",
                   "label"   : "SAS type",
                   "type"    : "listbox",
                   "values"  : "xtal2sas~c1~cryson~c2~crysol~c3",
                   "default" : "c1"
                   },
                  {
                   "role"    : "input",
                   "id"      : "reduced_x2_list_box",
                   "name"    : "reduced_x2_list_box",
                   "label"   : "chi-square type",
                   "type"    : "listbox",
                   "values"  : "reduced chi-square~c1~chi-square~c2~Pearson chi-square~c3",
                   "default" : "c1"
                   },
                   {
                   "role"    : "output",
                   "id"      : "chi_square_plot",
                   "label"   : "Chi-Square Distribution",
                   "type"    : "plot2d"
                   },
                   {
                   "role"    : "output",
                   "id"      : "iq_plot",
                   "label"   : "Scattering Plots",
                   "type"    : "plot2d"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "chi_square_filter"
}
