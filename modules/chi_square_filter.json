# this is a module file, any module specific info belongs here
{
    "moduleid" : "chi_square_filter",
    "label"    : "Chi-Square Filter",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Chi-Square Filter",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
		   "help"     : "results will be placed in a folder called filter/ in the directory name you enter here" 
                   },
                  {
                   "role"     : "input",
                   "id"       : "saspath",
                   "label"    : "path to SAS files",
                   "type"     : "text",
                   "default"  : "run_0/xtal2sas/",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "data_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "interpolated data file",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sasintfile",
                   "label"    : "SAS exp. data file (goal)",
                   "type"     : "file",
                   "required" : "true",
		   "help"     : "this should be interpolated experimental data sampled at the same q-values as generated by the SAS calculator",
                   "repeat"   : "data_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sasintfile_text",
                   "label"    : "SAS exp. data file (goal)",
                   "type"     : "text",
                   "required" : "true",
		   "help"     : "this should be interpolated experimental data sampled at the same q-values as generated by the SAS calculator",
                   "repeat"   : "data_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "io",
                   "label"    : "I(0)",
                   "type"     : "text",
                   "default"  : "0.019",
                   "required" : "true",
		   "help"     : "experimental scattering intensity at zero-angle ... usually obtained by Guinier analysis"
                   },
                  {
                   "role"    : "input",
                   "id"      : "sastype_list_box",
                   "name"    : "sastype_list_box",
                   "label"   : "SAS type",
                   "type"    : "listbox",
                   "values"  : "xtal2sas~c1~cryson~c2~crysol~c3",
                   "default" : "c1"
                   },
                  {
                   "role"    : "input",
                   "id"      : "reduced_x2_list_box",
                   "name"    : "reduced_x2_list_box",
                   "label"   : "chi-square type",
                   "type"    : "listbox",
                   "values"  : "reduced chi-square~c1~chi-square~c2~Pearson chi-square~c3",
                   "default" : "c1"
                   },
                  {
                   "role"     : "input",
                   "id"       : "advanced_input",
                   "label"    : "Check Box for Advanced Input",
                   "type"     : "checkbox",
                   "checked"  : "false",
		   "help"     : "check box to reveal input fields to generate weight files used to filter data",
                   "repeater" : "true" 
                   },
                  {
                   "role"     : "input",
                   "id"       : "x2highcut",
                   "label"    : "X2 high cutoff",
                   "type"     : "text",
		   "default"  : "10.0",
                   "required" : "true",
	   	   "help"     : "select SAS profiles with chi-square value less than this value... saved to associated weight file",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "x2highweightfile",
                   "label"    : "X2 high cutoff file (output)",
                   "type"     : "text",
                   "default"  : "x2highweights.txt",
                   "required" : "true",
	   	   "help"     : "weight file for high chi-square cutoff ... can be used by subsequent modules",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "x2lowcut",
                   "label"    : "X2 low cutoff",
                   "type"     : "text",
		   "default"  : "1.0",
                   "required" : "true",
	   	   "help"     : "select SAS profiles with chi-square value greater than this value... saved to associated weight file",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "x2lowweightfile",
                   "label"    : "X2 low cutoff file (output)",
                   "type"     : "text",
                   "default"  : "x2lowweights.txt",
                   "required" : "true",
	   	   "help"     : "weight file for low chi-square cutoff ... can be used by subsequent modules",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rghighcut",
                   "label"    : "Rg high cutoff",
                   "type"     : "text",
		   "default"  : "60.0",
                   "required" : "true",
	   	   "help"     : "select SAS profiles with radius of gyration values less than this value... saved to associated weight file",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rghighweightfile",
                   "label"    : "Rg high cutoff file (output)",
                   "type"     : "text",
                   "default"  : "rghighweights.txt",
                   "required" : "true",
	   	   "help"     : "weight file for high Rg cutoff ... can be used by subsequent modules",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rglowcut",
                   "label"    : "Rg low cutoff",
                   "type"     : "text",
		   "default"  : "40.0",
                   "required" : "true",
	   	   "help"     : "select SAS profiles with radius of gyration values greater than this value... saved to associated weight file",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rglowweightfile",
                   "label"    : "Rg low cutoff file (output)",
                   "type"     : "text",
                   "default"  : "rglowweights.txt",
                   "required" : "true",
	   	   "help"     : "weight file for low Rg cutoff ... can be used by subsequent modules",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0
                   },
                  {
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   },
                   {
                   "role"    : "output",
                   "id"      : "chi_square_plot",
                   "label"   : "Chi-Square Distribution",
                   "type"    : "plot2d"
                   },
                   {
                   "role"    : "output",
                   "id"      : "iq_plot",
                   "label"   : "Scattering Plots",
                   "type"    : "plot2d"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "chi_square_filter"
}
