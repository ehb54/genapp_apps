# this is a module file, any module specific info belongs here
{
    "moduleid" : "apbs",
    "label"    : "APBS",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "APBS",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"       : "input",
                   "id"         : "runname",
                   "label"      : "project name",
                   "type"       : "text",
                   "default"    : "run_0",
