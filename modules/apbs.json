                   "label"   : "ion concentration (M):",
                   "type"    : "float",
                   "default" : 5.2,
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "ion_charge",
                   "label"   : "ion charge:",
                   "type"    : "float",
                   "default" : 1.0,
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "largest_ion_radius",
