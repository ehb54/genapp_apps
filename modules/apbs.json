# this is a module file, any module specific info belongs here
{
    "moduleid" : "apbs",
    "label"    : "APBS",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "APBS",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"       : "input",
                   "id"         : "runname",
                   "label"      : "project name",
                   "type"       : "text",
                   "default"    : "run_0",
                   "required"   : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "reference pdb",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcd_list_box",
                   "name"    : "dcd_list_box",
                   "label"   : "input filename (dcd or pdb)",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to calculate solvation energies",
                   "repeat"   : "dcd_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to calculate solvation energies",
                   "repeat"   : "dcd_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "outfile",
                   "label"   : "output file name",
                   "type"    : "text",
                   "default" : "apbs.dat",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "ph",
                   "label"   : "pH",
                   "type"    : "text",
                   "default" : "5.2",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "temp",
                   "label"   : "temperature (K)",
                   "type"    : "text",
                   "default" : "300.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "ion_conc",
                   "label"   : "ion concentration (M):",
                   "type"    : "text",
                   "default" : "5.2",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "ion_charge",
                   "label"   : "ion charge:",
                   "type"    : "text",
                   "default" : "1.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "ion_radius",
                   "label"   : "largest ion radius:",
                   "type"    : "text",
                   "default" : "1.62",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "user_list_box",
                   "label"    : "user input file",
                   "type"    : "checkbox",
                   "checked" : "false",
                   "repeater" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "file_list_box",
                   "name"    : "file_list_box",
                   "label"   : " ",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
	           "repeat"  : "user_list_box",
                   "repeater" : "true",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "manualfile",
                   "label"    : "user apbs input file name",
                   "type"     : "file",
                   "required" : "false",
                   "repeat"  : "file_list_box:c1" 
                   },
                  {
                   "role"    : "input",
                   "id"      : "manualfile_text",
                   "label"    : "user apbs input file name",
                   "type"    : "text",
                   "default"  : "apbs_input.in",
                   "required" : "false",
                   "repeat"  : "file_list_box:c2" 
                   },
		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
                   }
                  ],
# the executable will take inputs in json and produce output in json
    "executable" : "apbs"
}
