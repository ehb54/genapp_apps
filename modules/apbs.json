                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile",
                   "label"   : "input file name (pdb)",
                   "type"    : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile",
                   "label"   : "input file name (dcd or pdb)",
                   "type"    : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "outfile",
                   "label"   : "output file name (dcd)",
