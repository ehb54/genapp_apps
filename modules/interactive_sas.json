# this is a module file, any module specific info belongs here
{
    "moduleid" : "interactive_sas",
    "label"    : "Interactive SAS",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Interactive SAS",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called interative_sas/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "pdb file input",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "output",
                   "id"    : "outputpdb",
                   "label" : "viewer (right click for options)",
                   "type"  : "atomicstructure",
                   "height" : "600",
                   "width" : "600"
                   }
                  ],
# the executable will take inputs in order and produce output
    "executable" : "interactive_sas"
}
