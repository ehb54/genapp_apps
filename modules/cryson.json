# this is a module file, any module specific info belongs here
{
    "moduleid" : "cryson",
    "label"    : "Cryson",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Crysol",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "project name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "pdb reference file name",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile",
                   "label"    : "trajectory file name (pdb or dcd)",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "maxh",
                   "label"    : "maximum harmonic order",
                   "type"     : "text",
                   "default"  : "15",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fib",
                   "label"    : "Fibonacci grid order",
                   "type"     : "text",
                   "default"  : "17",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "maxs",
                   "label"    : "maximum q value",
                   "type"     : "text",
                   "default"  : "0.5",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numpoints",
                   "label"    : "number of q points",
                   "type"     : "text",
                   "default"  : "51",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fd2O",
                   "label"    : "fraction solvent D2O",
                   "type"     : "text",
                   "default"  : "1.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sden",
                   "label"    : "solvent density",
                   "type"     : "text",
                   "default"  : "6.404",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fpep",
                   "label"    : "fraction non-X protein",
                   "type"     : "text",
                   "default"  : "0.1",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "contrast",
                   "label"    : "contrast of solvation shell",
                   "type"     : "text",
                   "default"  : "0.6404",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "delafs_list_box",
                   "name"    : "delafs_list_box",
                   "label"    : "delete alm/flm/sav files",
                   "type"    : "listbox",
                   "values"  : "yes~c1~no~c2",
                   "default" : "yes"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "cryson"
}
