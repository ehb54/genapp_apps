# this is a module file, any module specific info belongs here
{
    "moduleid" : "pdbrx",
    "label"    : "PDB Rx",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "PDB Rx",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called pdbrx/ in the directory name you enter here"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"   : "pdb file input",
                   #"type"     : "lrfile",
                   "type"     : "file",
                   "required" : "true",
                   "help"     : "name of input PDB file",
                   "norow"    : "false"
                   },
                   {
                   "role"       : "input",
                   "id"       : "advanced_input_header",
                   "label"    : "Advanced Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "advanced_input",
                   "label"    : "Check Box for Advanced Input",
                   "type"     : "checkbox",
                   "checked"  : "false",
                   "help"  : "click this box for extra options for the run",
                   "repeater" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "header_editor_box",
                   "label"    : "check box to implement options to edit PDB header information",
                   "type"    : "checkbox",
                   "checked" : "false",
                   "help" : "check box to activate options to edit segment, sequence and biomt information",
                   "repeater"  : "true",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0
                   },
                  {
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   },
                   {
                   "role"    : "output",
                   "id"    : "outputpdb",
                   "label" : "viewer (right click for options)",
                   "type"  : "atomicstructure",
                   "height" : "500",
                   "width" : "500"
                   },
                   {
                   "role"    : "output",
                   "id"    : "outputpdb_final",
                   "label" : "viewer (right click for options)",
                   "type"  : "atomicstructure",
                   "height" : "500",
                   "width" : "500"
                   },
                  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
                    "rows"    : 20,
                    "cols"    : 80
                   } 
                 ],
# the executable will take inputs in order and produce output
    "executable" : "pdbrx"
}
