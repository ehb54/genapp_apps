# this is a module file, any module specific info belongs here
{
    "moduleid" : "tamd",
    "label"    : "Torsion Angle MD",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Torsion Angle MD",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"       : "input",
                   "id"         : "runname",
                   "label"      : "run name",
                   "type"       : "text",
                   "default"    : "run_0",
                   "required"   : "true",
                   "help"     : "results will be placed in a folder called tamd/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile",
                   "label"   : "input file name (pdb)",
                   "type"    : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile",
                   "label"   : "input file name (dcd or pdb)",
                   "type"    : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "outfile",
                   "label"   : "output file name (dcd)",
                   "type"    : "text",
                   "default" : "run_0/minimization/min_run_0.dcd",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "nsteps",
                   "label"   : "number of minimization steps",
                   "type"    : "integer",
                   "default" : 100,
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "psffile",
                   "label"   : "charmm PSF filename",
                   "type"    : "file",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "ncpu",
                   "label"   : "number of processors",
                   "type"    : "integer",
                   "default" : 1,
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "keepout",
                   "label"   : "keep run output files (0==no, 1==yes)",
                   "type"    : "text",
                   "default" : "1",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcdfreq",
                   "label"   : "DCD write frequency",
                   "type"    : "integer",
                   "default" : 20,
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "md",
                   "label"   : "md run (0==minimize, 1==min/md, 2==min/md/min)",
                   "type"    : "integer",
                   "default" : 0,
                   "min"     : 0,
                   "max"     : 2,
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "mdsteps",
                   "label"   : "number md timesteps (1 step = 2 fs)",
                   "type"    : "float",
                   "default" : 10000,
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dielect",
                   "label"   : "solvent dielectric",
                   "type"    : "float",
                   "default" : 1.0,
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "temperature",
                   "label"   : "temperature (K)",
                   "type"    : "float",
                   "default" : 300.0,
                   "required" : "true"
                   },

                  {
                   "role"     : "input",
                   "id"       : "optional_input_header",
                   "label"    : "Complex Specific Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "n_flexible_seg",
                   "label"    : "number of flexible segments:",
                   "type"     : "integer",
                   "default"  : 2,
                   "required" : "true",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "segment_name",
                   "label"    : "segment name:",
                   "type"     : "text",
                   "required" : "false",
                   "repeat"   : "n_flexible_seg",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numranges",
                   "label"    : "number of ranges:",
                   "type"     : "integer",
                   "required" : "false",
                   "repeat"   : "n_flexible_seg",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "reslow",
                   "label"    : "enter low residues",
                   "type"     : "text",
                   "required" : "false",
                   "repeat"   : "n_flexible_seg",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numcont",
                   "label"    : "number contiguous residues",
                   "type"     : "text",
                   "required" : "false",
                   "repeat"   : "n_flexible_seg",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "moltype",
                   "label"    : "molecule type (protein or rna)",
                   "type"     : "listbox",
                   "values"   : "dna~c1~rna~c2~protein~c3",
                   "required" : "false",
                   "repeat"   : "n_flexible_seg",
                   "norow"    : "true"
                   },

		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
                   }
                  ],
# the executable will take inputs in json and produce output in json
    "executable" : "tamd"
}
