# this is a module file, any module specific info belongs here
{
    "moduleid" : "tamd",
    "label"    : "Torsion Angle MD",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Torsion Angle MD",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"       : "input",
                   "id"         : "runname",
                   "label"      : "run name",
                   "type"       : "text",
                   "default"    : "run_0",
                   "required"   : "true",
                   "help"     : "results will be placed in a folder called tamd/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "reference pdb",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcd_list_box",
                   "name"    : "dcd_list_box",
                   "label"   : "input filename (dcd or pdb)",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to run TAMD trajectories",
                   "repeat"   : "dcd_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "infile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to run TAMD trajectories",
                   "repeat"   : "dcd_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "outfile",
                   "label"   : "output file name (dcd)",
                   "type"    : "text",
                   "default" : "tamd_output.dcd",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "nsteps",
                   "label"   : "number of TAMD steps",
                   "type"    : "text",
                   "default" : "100",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "temperature",
                   "label"   : "temperature (K)",
                   "type"    : "text",
                   "default" : "300.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "keepout_checkbox",
                   "label"   : "check box to keep output files",
                   "type"    : "checkbox",
                   "checked" : "true",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcdfreq",
                   "label"   : "DCD write frequency",
                   "type"    : "text",
                   "default" : "20",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dna_segnames",
                   "label"   : "dna segment names",
                   "type"    : "text",
                   "default" : "None",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pretamd_min_steps",
                   "label"   : "number of preliminary minimization steps",
                   "type"    : "text",
                   "default" : "2000",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "poll_frequency",
                   "label"   : "poll frequency (seconds)",
                   "type"    : "text",
                   "default" : "60",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "rgforce",
                   "label"   : "Rg force",
                   "type"    : "text",
                   "default" : "0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "rgvalue",
                   "label"   : "Rg value",
                   "type"    : "text",
                   "default" : "0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "optional_input_header",
                   "label"    : "Complex Specific Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "number_flexible_segments",
                   "label"    : "number of segments with flexible regions:",
                   "type"     : "integer",
                   "default"  :  1,
                   "required" : "true",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "all_flexible_segnames",
                   "label"    : "segment name:",
                   "type"     : "text",
                   "required" : "true",
		   "default"  : "GAG",
                   "repeat"   : "number_flexible_segments",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "all_snumranges",
                   "label"    : "number of ranges:",
                   "type"     : "text",
                   "required" : "true",
		   "default"  : "1",
                   "repeat"   : "number_flexible_segments",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "all_srlow",
                   "label"    : "enter low residues",
                   "type"     : "text",
                   "required" : "true",
		   "default"  : "121",
                   "repeat"   : "number_flexible_segments",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "all_srnum",
                   "label"    : "number contiguous residues",
                   "type"     : "text",
                   "required" : "true",
		   "default"  : "23",
                   "repeat"   : "number_flexible_segments",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "all_moltype",
                   "label"    : "molecule type",
                   "type"     : "listbox",
                   "values"   : "protein~c1~dna~c2~rna~c3",
                   "required" : "true",
	 	   "default"  : "c1",
                   "repeat"   : "number_flexible_segments",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0
                   },
                  {
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   },
		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
                   }
                  ],
# the executable will take inputs in json and produce output in json
    "executable" : "tamd"
}
