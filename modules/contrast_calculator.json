# this is a module file, any module specific info belongs here
{
    "moduleid" : "contrast_calculator",
    "label"    : "Contrast Calculator",
    "fields"   : [

                   {
                   "role"     : "input",
                   "id"       : "module_header",
                   "label"    : "Contrast Calculator",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"       : "input",
                   "id"         : "runname",
                   "label"      : "run name",
                   "type"       : "text",
                   "default"    : "run_0",
                   "required"   : "true",
                   "help"     : "results will be placed in a folder called contrast_calc/ in the directory name you enter here"
                   },
                  {
                   "role"     : "input",
                   "id"       : "ofile",
                   "label"    : "output filename (no extension)",
                   "type"     : "text",
                   "default"  : "contrast_output",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called contrast_calc/ with the file name that you enter here"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numfile",
                   "label"    : "number of input files",
                   "type"     : "integer",
                   "default"  : 1,
                   "required" : "true",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fasta",
                   "label"    : "FASTA ?",
                   "type"     : "checkbox",
                   "checked"  : "false",
                   "repeat"   : "numfile",
                   "norow"    : "true",
		   "help"     : "check the box if the file contains sequence information in FASTA format"
                   },
                  {
                   "role"     : "input",
                   "id"       : "infile",
                   "label"    : "input file name",
                   "type"     : "file",
                   "required" : "true",
                   "repeat"   : "numfile",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "n_units",
                   "label"    : "number of units",
                   "type"     : "integer",
                   "required" : "true",
                   "repeat"   : "numfile",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fraction_deuterated",
                   "label"    : "fraction deuterated",
                   "type"     : "float",
                   "required" : "true",
                   "repeat"   : "numfile",
                   "norow"    : "true"
                   },
		          {
                   "role"     : "input",
                   "id"       : "moltype",
                   "label"    : "molecular type", 
                   "type"     : "listbox",
                   "values"   : "dna~c1~rna~c2~protein~c3",
                   "default"  : "c3",
                   "repeat"   : "numfile",
                   "norow"    : "true"
                   },

                  {
                   "role"     : "input",
                   "id"       : "optional_input_header",
                   "label"    : "Optional Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "solute_conc",
                   "label"    : "total solute concentration (mg/ml)",
                   "type"     : "text",
                   "default"  : "1.00",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "d2ostep",
                   "label"    : "solvent % D2O step",
                   "type"     : "text",
                   "default"  : "5",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fexchp",
                   "label"    : "fraction exchangeable H (protein)",
                   "type"     : "text",
                   "default"  : "0.95",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fexchn",
                   "label"    : "fraction exchangeable H (nucleic acid)",
                   "type"     : "text",
                   "default"  : "1.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "n_non_water_components",
                   "label"    : "number of non-water solvent components",
                   "type"     : "integer",
                   "default"  : 1,
                   "required" : "true",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "component",
                   "label"    : "component (atomic formula)",
                   "type"     : "text",
                   "repeat"   : "n_non_water_components",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "concentration",
                   "label"    : "concentration (M)",
                   "type"     : "float",
                   "required" : "true",
                   "repeat"   : "n_non_water_components",
                   "norow"    : "true"
                   }

                  ],
# the executable will take inputs in json and produce output in json
    "executable" : "contrast_calculator"
}
