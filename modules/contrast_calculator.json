# this is a module file, any module specific info belongs here
{
    "moduleid" : "contrast_calculator",
    "label"    : "Contrast Calculator",
    "fields"   : [

                   {
                   "role"     : "input",
                   "id"       : "module_header",
                   "label"    : "Contrast Calculator",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"       : "input",
                   "id"         : "runname",
                   "label"      : "run name",
                   "type"       : "text",
                   "default"    : "run_0",
                   "required"   : "true",
                   "help"     : "results will be placed in a folder called contrast_calc/ in the directory name you enter here"
                   },
                  {
                   "role"     : "input",
                   "id"       : "outfile",
                   "label"    : "output filename prefix (no extension)",
                   "type"     : "text",
                   "default"  : "contrast_output",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called contrast_calc/ with the file name that you enter here"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numfile",
                   "label"    : "enter number of protein, DNA or RNA input files",
                   "type"     : "integer",
                   "default"  : 2,
                   "required" : "true",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "isFasta",
                   "label"    : "FASTA ?",
                   "type"     : "listbox",
                   "values"   : "off~c1~on~c2",
                   "default"  : "c1",
                   "repeat"   : "numfile",
                   "norow"    : "true",
		   "help"     : "choose the value if the file contains sequence information in FASTA format"
                   },
                  {
                   "role"     : "input",
                   "id"       : "seqfiles",
                   "label"    : "input file name",
                   "type"     : "file",
                   "required" : "false",
                   "repeat"   : "numfile",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numunits",
                   "label"    : "number of units",
                   "type"     : "text",
                   "required" : "false",
		   "default"  : "1",
                   "repeat"   : "numfile",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fracdeut",
                   "label"    : "fraction deuterated",
                   "type"     : "text",
                   "required" : "false",
		   "default"  : "0.0",
                   "repeat"   : "numfile",
                   "norow"    : "true"
                   },
		          {
                   "role"     : "input",
                   "id"       : "moltype",
                   "label"    : "molecular type", 
                   "type"     : "listbox",
                   "values"   : "dna~c1~rna~c2~protein~c3",
                   "default"  : "c3",
                   "repeat"   : "numfile",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "number_of_chemicals",
                   "label"    : "enter number of addtional components",
                   "type"     : "integer",
                   "default"  : 0,
                   "required" : "true",
                   "repeater"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "chemical_formula",
                   "label"    : "chemical formula",
                   "type"     : "text",
                   "default"  : "C387H870O363P120N",
                   "required" : "true",
                   "repeat"   : "number_of_chemicals",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "number_exchangeable_hydrogens",
                   "label"    : "number exchangeable H",
                   "type"     : "text",
                   "default"  : "3",
                   "required" : "true",
                   "repeat"   : "number_of_chemicals",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fraction_exchangeable_hydrogens",
                   "label"    : "fraction exchangeable H",
                   "type"     : "text",
                   "default"  : "1.00",
                   "required" : "true",
                   "repeat"   : "number_of_chemicals",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "mass_density",
                   "label"    : "mass density",
                   "type"     : "text",
                   "default"  : "1.38",
                   "required" : "true",
                   "repeat"   : "number_of_chemicals",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "optional_input_header",
                   "label"    : "Optional Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "solute_conc",
                   "label"    : "total solute concentration (mg/ml)",
                   "type"     : "text",
                   "default"  : "1.00",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "d2ostep",
                   "label"    : "solvent % D2O step",
                   "type"     : "text",
                   "default"  : "5",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fexchp",
                   "label"    : "fraction exchangeable H (protein)",
                   "type"     : "text",
                   "default"  : "0.95",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "fexchn",
                   "label"    : "fraction exchangeable H (nucleic acid)",
                   "type"     : "text",
                   "default"  : "1.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numsolv",
                   "label"    : "number of non-water solvent components",
                   "type"     : "integer",
                   "default"  : 1,
                   "required" : "true",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "solv_comp",
                   "label"    : "component (atomic formula)",
                   "type"     : "text",
	           "default"  : "NaCl",
                   "repeat"   : "numsolv",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "solv_conc",
                   "label"    : "concentration (M)",
                   "type"     : "float",
                   "required" : "true",
		   "default"  : "0.15",
                   "repeat"   : "numsolv",
                   "norow"    : "true"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : "",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   },
                   {
                   "role"    : "output",
                   "id"      : "plotout1",
                   "label"   : "Scattering Length Density versus D2O Fraction",
                   "type"    : "plot2d"
                   },
                   {
                   "role"    : "output",
                   "id"      : "plotout2",
                   "label"   : "Contrast versus D2O Fraction",
                   "type"    : "plot2d"
                   },
                   {
                   "role"    : "output",
                   "id"      : "plotout3",
                   "label"   : "I(0) versus D2O Fraction",
                   "type"    : "plot2d"
                   },
                   {
                   "role"    : "output",
                   "id"      : "plotout4",
                   "label"   : "Sqrt[I(0)] versus D2O Fraction",
                   "type"    : "plot2d"
                   }
                  ],
# the executable will take inputs in json and produce output in json
    "executable" : "contrast_calculator"
}
