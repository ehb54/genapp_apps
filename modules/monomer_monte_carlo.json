# this is a module file, any module specific info belongs here
{
    "moduleid" : "monomer_monte_carlo",
    "label"    : "Monomer Monte Carlo",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Monomer Monte Carlo",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "input file name (pdb)",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile",
                   "label"    : "output file name (dcd)",
                   "type"     : "text",
                   "default"  : "run_0.dcd",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "trials",
                   "label"    : "number of trial attempts",
                   "type"     : "text",
                   "default"  : "100",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "goback",
                   "label"    : "return to previous structure",
                   "type"     : "text",
                   "default"  : "20",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "temp",
                   "label"    : "temperature (K)",
                   "type"     : "text",
                   "default"  : "300.0",
                   "required" : "true"
                   },
		  {
                   "role"    : "input",
                   "id"      : "moltype_list_box",
                   "name"    : "moltype_list_box",
                   "label"    : "molecule type",
                   "type"    : "listbox",
                   "values"  : "protein~c1~rna~c2",
                   "default" : "c1"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numranges",
                   "label"    : "number of flexible regions to vary",
                   "type"     : "text",
                   "default"  : "5",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dtheta",
                   "label"    : "enter MAX [dtheta] for each region",
                   "type"     : "text",
                   "default"  : "30.0,30.0,30.0,30.0,30.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "reslow",
                   "label"    : "first residue per region",
                   "type"     : "text",
                   "default"  : "123,277,354,378,408",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numcont",
                   "label"    : "number contiguous residues per region",
                   "type"     : "text",
                   "default"  : "21,5,20,11,4",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "lowres1",
                   "label"    : "structure alignment: low residue",
                   "type"     : "integer",
                   "default"  : 284,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "highres1",
                   "label"    : "structure alignment: high residue",
                   "type"     : "integer",
                   "default"  : 350,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "basis",
                   "label"    : "overlap basis",
                   "type"     : "text",
                   "default"  : "CA",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "cutoff",
                   "label"    : "overlap cutoff (angstroms)",
                   "type"     : "float",
                   "default"  : 3.0,
		   "step"     : 0.01,
                   "required" : "true"
                   },
                   {
                   "role"       : "input",
                   "id"       : "advanced_input_header",
                   "label"    : "Advanced Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "advanced_input",
                   "label"    : "Check Box for Advanced Input",
                   "type"     : "checkbox",
                   "checked"  : "false",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "lowrg",
                   "label"    : "low Rg cutoff",
                   "type"     : "float",
                   "default"  : 0.0,
                   "min"      : 0.0,
	           "step"     : 0.01,
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "highrg",
                   "label"    : "high Rg cutoff",
                   "type"     : "float",
                   "default"  : 300.0,
	           "step"     : 0.01,
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
		  {
                   "role"    : "input",
                   "id"      : "zflag_list_box",
                   "name"    : "zflag_list_box",
                   "label"    : "Z coordinate filter", 
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "c1",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "zcutoff",
                   "label"    : "Z cutoff (angstroms)",
                   "type"     : "float",
                   "default"  : 0.0,
	           "step"     : 0.01,
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
		  {
                   "role"    : "input",
                   "id"      : "plotflag_list_box",
                   "name"    : "plotflag_list_box",
                   "label"    : "plot Rg during run",
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "c1",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "directedmc",
                   "label"    : "directed Monte Carlo (0==no or Rg value)",
                   "type"     : "text",
                   "default"  : "0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
		  {
                   "role"    : "input",
                   "id"      : "cflag_list_box",
                   "name"    : "cflag_list_box",
                   "label"    : "check box to use atomic constraints",
                   "type"    : "checkbox",
                   "checked" : "false",
                   "repeat"  : "advanced_input",
		   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "confile",
                   "label"    : "constraint file name",
                   "type"     : "file",
                   "required" : "false",
		   "default"  : "contraints.txt",
                   "repeat"  : "cflag_list_box"
                   },
		  {
                   "role"    : "input",
                   "id"      : "nonbondflag_list_box",
                   "name"    : "nonbondflag_list_box",
                   "label"    : "check box to use non-bonding energies",
                   "type"    : "checkbox",
                   "checked" : "false",
                   "repeat"  : "advanced_input",
                   "repeater"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "nonbondscale",
                   "label"    : "non-bonding scale factor",
                   "type"     : "float",
                   "default"  : 1.0,
	           "step"     : 0.01,
                   "required" : "true",
                   "repeat"  : "nonbondflag_list_box"
                   },
                  {
                   "role"     : "input",
                   "id"       : "psffilename",
                   "label"    : "psf file name",
                   "type"     : "file",
                   "required" : "false",
                   "default"  : "refgag.psf",
                   "repeat"  : "nonbondflag_list_box"
                   },
                   {
                   "role"    : "output",
                   "id"      : "plotout4",
                   "label"   : "all rg and accepted rg data",
                   "type"    : "plot2d"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : "",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "monomer_monte_carlo"
}
