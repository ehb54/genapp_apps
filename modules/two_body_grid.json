# this is a module file, any module specific info belongs here
{
    "moduleid" : "two_body_grid",
    "label"    : "Two Body Grid",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Two Body Grid",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "project name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "mol_1_label",
                   "label"    : "Molecule 1[reference structure]",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "input pdb file (mol 1)",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdbfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "PDB file for the reference structure",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdbfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "PDB file for the reference structure",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "mol_2_label",
                   "label"    : "Molecule 2[structure to move]",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "movepdb_list_box",
                   "name"    : "movepdb_list_box",
                   "label"   : "input pdb file (mol 2)",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "movepdbfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "PDB file to be moved",
                   "repeat"   : "movepdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "movepdbfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "PDB file to be moved",
                   "repeat"   : "movepdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "mol_out_label",
                   "label"    : "Output",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile",
                   "label"    : "output file name (dcd)",
                   "type"     : "text",
                   "default"  : "run_0.dcd",
                   "required" : "true"
                   },
#
                  {
                   "role"     : "input",
                   "id"       : "mol_out_label",
                   "label"    : "Move Input Section (mol 2)",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "acceptIntial_list_box",
                   "label"   : "accept supplied initial position",
                   "type"    : "listbox",
                   "values"  : "yes~c1~no~c2",
                   "default" : "c2"
                   },
                  {
                   "role"     : "input",
                   "id"       : "x0",
                   "label"    : "initial position x,y,z (COM mol 2)",
