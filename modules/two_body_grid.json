                   "repeat"  : "excluded_input"
		  },
                  {
                   "role"     : "input",
                   "id"       : "first1_exluded",
                   "label"    : "first amino acid per segment (mol1)",
                   "type"     : "text",
                   "default"  : "271,271,94",
                   "required" : "true",
                   "repeat"  : "excluded_input"
		  },
                  {
                   "role"     : "input",
                   "id"       : "ncont1_exluded",
                   "label"    : "number of contiguous amino acids per segment (mol 1)",
                   "type"     : "text",
                   "default"  : "18,18,31",
                   "required" : "true",
                   "repeat"  : "excluded_input"
		  },
                  {
                   "role"     : "input",
                   "id"       : "n2_exluded",
                   "label"    : "number of segments with excluded residues (mol 2)",
                   "type"     : "text",
                   "default"  : "3",
                   "required" : "true",
                   "repeat"  : "excluded_input"
		  },
                  {
                   "role"     : "input",
                   "id"       : "name2_exluded",
                   "label"    : "name of segments with excluded residues (mol 2)",
                   "type"     : "text",
                   "default"  : "INT3,INT4,LED2",
                   "required" : "true",
                   "repeat"  : "excluded_input"
		  },
                  {
                   "role"     : "input",
                   "id"       : "first2_exluded",
                   "label"    : "first amino acid per segment (mol2)",
                   "type"     : "text",
                   "default"  : "271,271,94",
                   "required" : "true",
                   "repeat"  : "excluded_input"
		  },
                  {
                   "role"     : "input",
                   "id"       : "ncont2_exluded",
                   "label"    : "number of contiguous amino acids per segment (mol 2)",
                   "type"     : "text",
                   "default"  : "18,18,31",
                   "required" : "true",
                   "repeat"  : "excluded_input"
		  },
                  {
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0
                   },
                  {
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "two_body_grid"
}
