                   "default"  : "5,5,5",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "xyz_step_size",
                   "label"    : "dx,dy,dz step sizes",
                   "type"     : "text",
                   "default"  : "20,20,20",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "n_ang_moves",
                   "label"    : "number of angular moves",
                   "type"     : "text",
                   "default"  : "4,4,4",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "theta_step_size",
                   "label"    : "dtheta (x,y,z) step sizes",
                   "type"     : "text",
                   "default"  : "45,45,45",
                   "required" : "true"
                   },
#
                   {
                   "role"       : "input",
                   "id"       : "advanced_input_header",
                   "label"    : "Advanced Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "advanced_input",
                   "label"    : "Check Box for Advanced Input",
                   "type"     : "checkbox",
                   "checked"  : "false",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "basis",
                   "label"    : "overlap basis",
                   "type"     : "text",
                   "default"  : "CA",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "cutoff",
                   "label"    : "overlap cutoff",
                   "type"     : "text",
                   "default"  : "3.0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "lowrg",
                   "label"    : "low Rg cutoff",
                   "type"     : "text",
                   "default"  : "0.0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "highrg",
                   "label"    : "high Rg cutoff",
                   "type"     : "text",
                   "default"  : "400.0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
		  {
                   "role"    : "input",
                   "id"      : "zflag_list_box",
                   "name"    : "zflag_list_box",
                   "label"    : "Z coordinate filter", 
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "c1",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "zcutoff",
                   "label"    : "Z cutoff (angstroms)",
                   "type"     : "text",
                   "default"  : "0.0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
		  {
                   "role"    : "input",
                   "id"      : "cflag_list_box",
                   "name"    : "cflag_list_box",
                   "label"    : "check box to use atomic constraints",
                   "type"    : "checkbox",
                   "checked" : "false",
                   "repeat"  : "advanced_input",
		   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "confile",
                   "label"    : "constraint file name",
                   "type"     : "file",
                   "required" : "false",
		   "default"  : "contraints.txt",
                   "repeat"  : "cflag_list_box"
                   },
#
                   {
                   "role"       : "input",
                   "id"       : "excluded_residue_header",
                   "label"    : "Excluded Residue Section",
