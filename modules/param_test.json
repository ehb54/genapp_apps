# this is a module file, any module specific info belongs here
{
    "moduleid" : "param_test",
    "label"    : "Calculate",
    #"help"     : "help for Bead Modeller",
    #"center"   : "true",
    #"centeroutput" : "true",
    #"notify"    : "alexsav.science@gmail.com",
    "fields"   : [
               {
	            "role"       : "input"
	            ,"id"         : "projectname"
	            ,"label"      : "Project name"
	            ,"type"       : "text"
	            ,"required"   : "true"
	            ,"help"       : "Enter a project name"
	            ,"specifiedproject" : "Run_"
	        },
################################################################
	       { 
		   "role"     : "input",  
		   "id"       : "toppar_label",
		   "label"    : "TOPOLOGY GENERATION AND PARAMETERIZATION",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },

                  {
                   "role"     : "input",
                   "id"       : "pdb_location",
                   "label"    : "Input PDB file",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },
 
                { 
                     "role"     : "input",  
                     "id"       : "add_waterbox",
                     "label"    : "Add Solvation Box?",
                     "type"     : "checkbox",  
                     "checked"  : "false",
		     "required" : "false",
                     "repeater" : "yes",
		     "help"     : "help"
		 },
                { 
                     "role"     : "input",  
                     "id"       : "size_x",
                     "label"    : "Periodic Cell Size, X:",
                     "type"     : "float",  
                     "default"  : 40,
		     "min"      : 1, 
		     "required" : "true",
                     "repeat"   : "add_waterbox",
		     "help"     : "help"
		 },	    
                { 
                     "role"     : "input",  
                     "id"       : "size_y",
                     "label"    : "Periodic Cell Size, Y:",
                     "type"     : "float",  
                     "default"  : 40,
		     "min"      : 1, 
		     "required" : "true",
                     "repeat"   : "add_waterbox",
		     "help"     : "help"
		 },	    
                { 
                     "role"     : "input",  
                     "id"       : "size_z",
                     "label"    : "Periodic Cell Size, Z:",
                     "type"     : "float",  
                     "default"  : 40,
		     "min"      : 1, 
		     "required" : "true",
                     "repeat"   : "add_waterbox",
		     "help"     : "help"
		 },	    

                { 
                     "role"     : "input",  
                     "id"       : "add_ions",
                     "label"    : "Add Ions?",
                     "type"     : "checkbox",  
                     "checked"  : "false",
		     "required" : "false",
		     "repeat"   : "add_waterbox",
                     "repeater" : "yes",
		     "help"     : "help"
		 },
                { 
                     "role"     : "input",  
                     "id"       : "ion_type",
                     "label"    : "Ion Type:",
                     "type"     : "listbox",
		     "values"   : "NaCl~SOD~KCl~POT",
                     "default"  : "SOD",
		     "required" : "true",
                     "repeat"   : "add_ions",
		     "help"     : "help"
		 },	    	
                { 
                     "role"     : "input",  
                     "id"       : "ion_conc",
                     "label"    : "Ionic Concentration (M):",
                     "type"     : "float",  
                     "default"  : 0.5,
		     "min"      : 0, 
		     "required" : "true",
                     "repeat"   : "add_ions",
		     "help"     : "help"
		 },	    

#######################################################################################
	       { 
		   "role"     : "input",  
		   "id"       : "mdinput_label",
		   "label"    : "MD/MM INPUT",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },
                { 
                     "role"     : "input",  
                     "id"       : "min_options",
                     "label"    : "Minimize structure before MD?",
                     "type"     : "checkbox",  
                     "checked"  : "false",
		     "required" : "false",
                     "repeater" : "yes",
		     "help"     : "help"
		 },
                { 
                     "role"     : "input",  
                     "id"       : "mm_min_num_steps",
                     "label"    : "Number of Minimization Steps",
                     "type"     : "integer",  
                     "default"  : 1000,
		     "min"      : 1, 
		     "required" : "true",
                     "repeat"   : "min_options",
		     "help"     : "help"
		 },
               { 
                     "role"     : "input",  
                     "id"       : "md_options",
                     "label"    : "Run MD?",
                     "type"     : "checkbox",  
                     "checked"  : "false",
		     "required" : "false",
                     "repeater" : "yes",
		     "help"     : "help"
		 },	
	
               { 
                     "role"     : "input",  
                     "id"       : "md_num_steps",
                     "label"    : "Number of Simulation Steps",
                     "type"     : "integer",  
                     "default"  : 1000,
		     "min"      : 1, 
		     "required" : "true",
                     "repeat"   : "md_options",
		     "help"     : "help"
		 },
              { 
                     "role"     : "input",  
                     "id"       : "temperature",
                     "label"    : "Temperature (K)",
                     "type"     : "float",  
                     "default"  : 298,
		     "min"      : 1, 
		     "required" : "true",
                     "repeat"   : "md_options",
		     "help"     : "help"
		 },
                { 
                     "role"     : "input",  
                     "id"       : "pressure",
                     "label"    : "Pressure (Bar)",
                     "type"     : "float",  
                     "default"  : 1.01325,
		     "min"      : 1, 
		     "required" : "true",
                     "repeat"   : "md_options",
		     "help"     : "help"
		 },
                { 
                     "role"     : "input",  
                     "id"       : "output_frequency",
                     "label"    : "Output Frequency (steps)",
                     "type"     : "integer",  
                     "default"  : 100,
		     "min"      : 1, 
		     "required" : "true",
                     "repeat"   : "md_options",
		     "help"     : "help"
		 },
               { 
                     "role"     : "input",  
                     "id"       : "movie_show",
                     "label"    : "Generate Trajectory Movie?",
                     "type"     : "checkbox",  
                     "checked"  : "true",
		     "required" : "false",
                     "repeat"   : "md_options",
		     "repeater" : "yes",
		     "help"     : "help"
		 },	
               { 
                     "role"     : "input",  
                     "id"       : "movie_choice",
                     "label"    : "",
                     "type"     : "listbox",  
                     "values"   : "with solvent~withsolvent~no solvent~nosolvent",
		     "default"  : "withsolvent",
                     "repeat"   : "movie_show",
		     "help"     : "help"
		 },		
#######################################################################################
	       { 
		   "role"     : "input",  
		   "id"       : "analysis_label",
		   "label"    : "TRAJECTORY ANALYSIS",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },
              { 
                     "role"     : "input",  
                     "id"       : "analysis_options_evolutions",
                     "label"    : "Evolution of Macroscopic Parameters",
                     "type"     : "checkbox",  
                     "checked"  : "false",
		     "required" : "false",
		     "repeater" : "yes",
                     "help"     : "help"
		 },		
               { 
                     "role"     : "input",  
                     "id"       : "analysis_options_evolutions_temperature",
                     "label"    : "Generate Temperature Plot?",
                     "type"     : "checkbox",  
                     "checked"  : "true",
		     "required" : "false",
		     "repeat"   : "analysis_options_evolutions",
                     "help"     : "help"
		 },	
               { 
                     "role"     : "input",  
                     "id"       : "analysis_options_evolutions_totenergy",
                     "label"    : "Generate Total Enegry Plot?",
                     "type"     : "checkbox",  
                     "checked"  : "true",
		     "required" : "false",
		     "repeat"   : "analysis_options_evolutions",
                     "help"     : "help"
		 },	

#####################################################################################################
                 {
		     "role"    : "output",
		     "id"      : "progress_output",
		     "label"   : "Progress: ",
		     "type"    : "progress",
		     "max"     : 1.0
		 },	
                {
		   "role"    : "output",
                   "id"      : "progress_text",
                   "label"   : "Calculation Report: ",
		   "type"    : "textarea",
                   #"append"  : "on",
                   "cols"    : 40
                  },

                  {
                   "role"  : "output",
                   "id"    : "outputpdb",
                   "label" : "PDB: ",
                   "type"  : "file"
                   },	
                 {
                   "role"  : "output",
                   "id"    : "outputcrd",
                   "label" : "CRD: ",
                   "type"  : "file"
                   },	
                 {
                   "role"  : "output",
                   "id"    : "outputpsf",
                   "label" : "PSF: ",
                   "type"  : "file"
                   },	
                {
                   "role"  : "output",
                   "id"    : "outputxplorpsf",
                   "label" : "XPLOR PSF: ",
                   "type"  : "file"
                   },	

	           {
                   "role"  : "output",
                   "id"    : "outputmin",
                   "label" : "Minimization Results: ",
                   "type"  : "file",
		   "multiple": "true"    
                   },
	           {
                   "role"  : "output",
                   "id"    : "outputmd",
                   "label" : "MD Simulation Results: ",
                   "type"  : "file",
		   "multiple": "true"    
                   },
                  
	           {
                   "role"  : "output",
                   "id"    : "outputanalysis",
                   "label" : "Analysis Results: ",
                   "type"  : "file",
		   "multiple": "true"    
                   },
	
	         {
                   "role"  : "output",
                   "id"    : "outputpdb_view",
                   "label" : "Atomistic Model (right click for options): ", 
                   "type"  : "atomicstructure",
		   "jsmoladd" : "hide HOH;spin on",
		   "width"     : 450,
	           "height"    : 450
		   # "norow" : "true"
		   #"repeat" : "show_atomistic_model"
		     
                   },
                 {
                   "role"       : "output",
                   "id"         : "vid",
		   "type"       : "video",
		   "label"      : "Trajectory Movie",
		   "width"      : 400
		   #"height"    : 450   
                 },	

	           {
                   "role"  : "output",
                   "id"    : "temperature_plot",
                   "label" : "Temperature Evolution Plot:",
                   "type"  : "plot2d",
		   "height": "220px",
		   "width" : "450px",
		   "pan"   : "true",
		   "zoom"  : "true",
		   "hover" : "true"
                   },
	           {
                   "role"  : "output",
                   "id"    : "totenergy_plot",
                   "label" : "Total Energy Evolution Plot:",
                   "type"  : "plot2d",
		   "height": "220px",
		   "width" : "450px",
		   "pan"   : "true",
		   "zoom"  : "true",
		   "hover" : "true"
                   }
	         ],
# the executable will take inputs in order and produce output
    "executable" : "parammd.py",
    "submitpolicy" : "all"    
}
