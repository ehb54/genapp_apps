# this is a module file, any module specific info belongs here
{
    "moduleid" : "altens",
    "label"    : "Altens",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Altens",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called pdbscan/ in the directory name you enter here"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"   : "pdb file input",
                   "type"     : "lrfile",
                   "required" : "true",
                   "help"     : "name of PDB file you wish to scan",
                   "norow"    : "false"
                   },
                  {
                   "role"     : "input",
                   "id"       : "rdc_input_file",
                   "label"   : "RDC data file",
                   "type"     : "lrfile",
                   "required" : "true",
                   "help"     : "name of file with RDC data",
                   "norow"    : "false"
                   },
                  {
                   "role"     : "input",
                   "id"       : "residue_list_file",
                   "label"   : "residue list file",
                   "type"     : "lrfile",
                   "required" : "true",
                   "help"     : "name of file with residue list data",
                   "norow"    : "false"
                   },

                  {
                   "role"    : "input",
                   "id"      : "use_monte_carlo_flag_checkbox",
                   "label"   : "Monte Carlo sampling option",
                   "type"    : "checkbox",
                   "help"    : "click box to enable Monte Carlo sampling",
                   "repeater": "true",
                   "checked" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "number_of_monte_carlo_steps",
                   "label"    : "enter number of Monte Carlo steps",
                   "type"     : "text",
                   "default"  : "1000",
                   "size"     : 4,
                   "help"     : "supply appropriate value",
                   "repeat"   : "use_monte_carlo_flag_checkbox"
                  },
                  {
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0
                   },
                  {
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   },
                   {
                     "role"    : "output",
                     "id"      : "report_html",
                     "name"    : "report_html",
                     "label"   : "report : ",
                     "type"    : "html"
                    }
                 ],
# the executable will take inputs in order and produce output
    "executable" : "altens"
}
