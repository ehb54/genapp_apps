#This is the Bayesian Ensemble Estimator from SAS (BEES) module file, contains module specific info

{
    "moduleid": "bayesian_ensemble_estimator",
    "label":    "Bayesian Ensemble Estimator",
    "fields":   [
                {
                    "role"      : "input",
                    "id"        : "module_header",
                    "label"     : "Bayesian Ensemble Estimator from SAS (BEES)",
                    "type"      : "label",
                    "default"   : "header4",
                    "prehline"  : "true",
                    "posthline" : "true"
                },
                {
                    "role"      :   "input",
                    "id"        :   "runname",
                    "label"     :   "run name",
                    "type"      :   "text",
                    "default"   :   "run_0",
                    "required"  :   "true",
                    "help"      :   "results will be placed in a folder called \"bayesian_ensemble_estimator/\" in the directory name you enter here."
                },
                {
                    "role"      :   "input",
                    "id"        :   "sas_data",
                    "label"     :   "interpolated data file",
                    "type"      :   "lrfile",
                    "required"  :   "true",
                    "help"      :   "this is the interpolated scattering data file (must have same q-values as generated by SAS calculator)",
                    "norow"     :   "false"
                },
                {
                    "role"      :   "input",
                    "id"        :   "d_max",
                    "label"     :   "D_max",
                    "type"      :   "text",
                    "default"   :   "0.0",
                    "required"  :   "true",
                    "help"      :   "D_max is determined from the experimental profile and used to conduct Shannon Sampling of the data",
                    "norow"     :   "false"
                },
                {
                    "role"      :   "input",
                    "id"        :   "theoretical_profiles_zip",
                    "label"     :   "theoretical profiles zip",
                    "type"      :   "lrfile",
                    "required"  :   "true",
                    "help"      :   "zip archive of theoretical states (q-values must match those of \"interpolated data file\")",
                    "norow"     :   "false"
                },
                {
                    "role"      :   "input",
                    "id"        :   "max_iterations",
                    "label"     :   "max iterations",
                    "type"      :   "text",
                    "default"   :   "100",
                    "required"  :   "true",
                    "help"      :   "Number of steps in each sub-ensemble Monte Carlo routine"
                },
                {
                    "role"      :   "input",
                    "id"        :   "posterior_burn",
                    "label"     :   "posterior burn",
                    "type"      :   "text",
                    "default"   :   "10",
                    "required"  :   "true",
                    "help"      :   "Number of steps to forget from beginning of Monte Carlo routine"
                },
                {
                    "role"      :   "input",
                    "id"        :   "number_of_MCs",
                    "label"     :  "number of Monte Carlo cycles",
                    "type"      :   "text",
                    "default"   :   "3",
                    "required"  :   "true",
                    "help"      :   "Number of Monte Carlo routines per sub-ensemble set"
                },
                {
                    "role"      :   "input",
                    "id"        :   "nproc",
                    "label"     :   "number of processors",
                    "type"      :   "integer",
	            "default" : 4,
                    "min"     : 1,
                    "max"     : 16,
                    "help" : "choose between 1 and 16",
                    "required"  :   "true",
                    "help"      :   "Computational time can be decreased by using nproc > 1, as long as the number of processors is not larger than the number of sub-ensembles"
                },
                {
                    "role"      :   "input",
                    "id"        :   "advanced_input_header",
                    "label"     :   "Advanced Input",
                    "type"      :   "label",
                    "default"   :   " ",
                    "prehline"  :   "true",
                    "posthline" :   "true"
                },
                {
                    "role"      :   "input",
                    "id"        :   "advanced_input",
                    "label"     :   "Check Box for Advanced Input",
                    "type"      :   "checkbox",
                    "checked"   :   "false",
                    "help"      :   "Click this box if you would like to use advanced options for the run",
                    "repeater"  :   "true"
                },
                {
                    "role"      :   "input",
                    "id"        :   "use_auxiliary_data_checkbox",
                    "label"     :   "Use Auxiliary Data",
                    "type"      :   "checkbox",
                    "checked"   :   "false",
                    "norow"     :   "false",
                    "help"      :   "Click here to add an additional set of data to the fitting routine",
                    "repeat"    :   "advanced_input",
                    "repeater"  :   "true"
                },
                {
                    "role"      :   "input",
                    "id"        :   "auxiliary_data",
                    "label"     :   "Auxiliary Data File",
                    "type"      :   "lrfile",
                    "required"  :   "true",
                    "norow"     :   "false",
                    "repeat"    :   "use_auxiliary_data_checkbox",
                    "help"      :   "Upload a two column text file (column 1 = measurement values, column 2 = error in measurement)"
                },
                {
                    "role"      :   "input",
                    "id"        :   "every_checkbox",
                    "label"     :   "Do Every Combination",
                    "type"      :   "checkbox",
                    "checked"   :   "false",
                    "norow"     :   "false",
                    "help"      :   "Click here to build every possible combination from your theoretical states (Warning: can be VERY time consuming!)",
                    "repeat"    :   "advanced_input"
                },
                {
                    "role"      :   "input",
                    "id"        :   "use_all_checkbox",
                    "label"     :   "Use All States",
                    "type"      :   "checkbox",
                    "checked"   :   "false",
                    "norow"     :   "false",
                    "help"      :   "Create only the single model built from all candidate states at once (overrides the \"Do Every Combination\" option)",
                    "repeat"    :   "advanced_input"
                },
                {
                    "role"      :   "input",
                    "id"        :   "use_shansamp_checkbox",
                    "label"     :   "Do Shannon Sampling",
                    "type"      :   "checkbox",
                    "checked"   :   "true",
                    "norow"     :   "false",
                    "help"      :   "Click here to use Shannon Sampling on interpolated data (use chi^2 free)",
                    "repeat"    :   "advanced_input"
                },
                {
                    "role"      :   "input",
                    "id"        :   "use_bic_checkbox",
                    "label"     :   "Use BIC",
                    "type"      :   "checkbox",
                    "checked"   :   "false",
                    "norow"     :   "false",
                    "help"      :   "Click here to use the Bayesian Information Criterion (BIC) in place of the Akaike Information Criterion (AIC)",
                    "repeat"    :   "advanced_input"
                },
                {
                    "role"      :   "input",
                    "id"        :   "advanced_mc_input",
                    "label"     :   "Advanced Monte Carlo Inputs",
                    "type"      :   "checkbox",
                    "checked"   :   "false",
                    "norow"     :   "false",
                    "help"      :   "Click here to modify Monte Carlo integrator parameters",
                    "repeat"    :   "advanced_input",
                    "repeater"  :   "true"
                },
                {
                    "role"      :   "input",
                    "id"        :   "sigma",
                    "label"     :   "Walk Width",
                    "type"      :   "text",
                    "default"   :   "0.10",
                    "norow"     :   "false",
                    "help"      :   "Enter the width (sigma value) of the Gaussian distribution from which to randomly sample the Monte Carlo walk increments",
                    "repeat"    :   "advanced_mc_input"
                },
                {
                    "role"      :   "input",
                    "id"        :   "walk_one",
                    "label"     :   "Increment One Population at a Time",
                    "type"      :   "checkbox",
                    "checked"   :   "false",
                    "norow"     :   "false",
                    "help"      :   "Click here to increment the population of only one state at a time per Monte Carlo iteration",
                    "repeat"    :   "advanced_mc_input"
                },
                {
                    "role"      :   "input",
                    "id"        :   "zeroing_threshold",
                    "label"     :   "Minimum Population",
                    "type"      :   "text",
                    "default"   :   "0.0",
                    "norow"     :   "false",
                    "help"      :   "Populations below this value at each Monte Carlo iteration will be set to \"0.0\"",
                    "repeat"    :   "advanced_mc_input"
                },
                {
                    "role"      :   "output",
                    "id"        :   "progress_output",
                    "label"     :   "progress: ",
                    "type"      :   "progress",
                    "max"       :   1.0
                },
                {
                    "role"      :   "output",
                    "id"        :   "progress_html",
                    "name"      :   "progress_html",
                    "label"     :   "percent done: ",
                    "type"      :   "html"
                }
		#},
                 #  {
                 #    "role"    : "output",
                 #    "id"      : "bokeh_plots",
                 #    "label"    : " ",
                 #    "type"    : "bokeh"
                 #   }
                ],
    "executable"    :   "bayesian_ensemble_estimator"
}

