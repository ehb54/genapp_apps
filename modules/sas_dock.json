                   #"role"       : "input",
                   #"id"       : "advanced_input_header",
                   #"label"    : "Advanced Input",
                   #"type"     : "label",
                   #"default"  : " ",
                   #"prehline"  : "true",
                   #"posthline"  : "true"
                   #},
                  #{
                  # "role"     : "input",
                  # "id"       : "advanced_input",
                  # "label"    : "Check Box for Advanced Input",
                  # "type"     : "checkbox",
                  # "checked"  : "false",
                  # "help"  : "click this box for extra options for the run",
                  # "repeater" : "true"
                  # },
                  #{
                  # "role"     : "input",
                  # "id"       : "r",
                  # "label"    : "atomic radius for docking map construction",
                  # "help"     : "defined as r in paper -- PNAS 89: 2195-2199",
                  # "type"     : "float",
                  # "default"  : 1.8,
                  # "required" : "true",
                  # "repeat"  : "advanced_input"
                  # },
#
                  {   
                   "role"    : "output",
                   "id"      : "progress_output",
                   "label"   : "progress: ",
                   "type"    : "progress",
                   "max"     : 1.0 
                   },  
                  {   
                    "role"    : "output",
                    "id"      : "progress_html",
                    "name"    : "progress_html",
                    "label"   : "percent done: ",
                    "type"    : "html"
                   }
                  ],
    "executable" : "sas_dock"
}
