	            ,"type"       : "text"
	            ,"required"   : "true"
	            ,"help"       : "Enter a project name"
	            ,"specifiedproject" : "Run_"
	        },
################################################################
	       { 
		   "role"     : "input",  
		   "id"       : "toppar_label",
		   "label"    : "TOPOLOGY AND INITIAL STRUCTURE",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },

                  {
                   "role"     : "input",
                   "id"       : "coor_location",
                   "label"    : "Coordinate file",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },
 
                 {
                   "role"     : "input",
                   "id"       : "psf_location",
                   "label"    : "PSF file",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },	
 
                 {
                   "role"     : "input",
                   "id"       : "toppar_location",
                   "label"    : "Parameter file (archive)",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },	

                  {
                   "role"     : "input",
                   "id"       : "script_location",
                   "label"    : "Input NAMD script",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },	


#####################################################################################################
                 {
		     "role"    : "output",
		     "id"      : "progress_output",
		     "label"   : "Progress: ",
		     "type"    : "progress",
		     "max"     : 1.0
		 },	
                {
		   "role"    : "output",
                   "id"      : "progress_text",
                   "label"   : "Calculation Report: ",
		   "type"    : "textarea",
                   #"append"  : "on",
                   "cols"    : 40
                  },

	           {
                   "role"  : "output",
                   "id"    : "outputmd",
                   "label" : "MD Simulation Results: ",
                   "type"  : "file",
		   "multiple": "true"    
                  }
	         ],
# the executable will take inputs in order and produce output
    "executable" : "namdrun.py",
    "submitpolicy" : "all"    
}
