# this is a module file, any module specific info belongs here
{
    "moduleid" : "namd_run",
    "label"    : "Calculate",
    "resource" : "oscluster",
    "submitpolicy" : "login",
    #"help"     : "help for Bead Modeller",
    #"center"   : "true",
    #"centeroutput" : "true",
    #"notify"    : "alexsav.science@gmail.com",
    "notify" : "email",
    "fields"   : [
               {
	            "role"       : "input"
	            ,"id"         : "projectname"
	            ,"label"      : "Project name"
	            ,"type"       : "text"
	            ,"required"   : "true"
	            ,"help"       : "Enter a project name"
	            ,"specifiedproject" : "Run_"
	        },
################################################################
	       { 
		   "role"     : "input",  
		   "id"       : "toppar_label",
		   "label"    : "TOPOLOGY AND INITIAL STRUCTURE",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },

                  {
                   "role"     : "input",
                   "id"       : "coor_location",
                   "label"    : "Coordinate file",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },

                  {
                   "role"     : "input",
                   "id"       : "check_vel",
                   "label"    : "Submit velocity file?",
                   "type"     : "checkbox",
		   "checked"  : "false",
		   "repeater" : "true",  
                   "help"     : "help"
                   },
                  {
                   "role"     : "input",
                   "id"       : "vel_location",
                   "label"    : "Velocity file",
                   "type"     : "lrfile",
		   "repeat"   : "check_vel",  
                   "required" : "true",
		   "help"     : "help"
                   },	
 
                  {
                   "role"     : "input",
                   "id"       : "check_box",
                   "label"    : "Submit .XSC file?",
                   "type"     : "checkbox",
		   "checked"  : "false",
		   "repeater" : "true",  
                   "help"     : "help"
                   },
                  {
                   "role"     : "input",
                   "id"       : "box_location",
                   "label"    : "XSC file",
                   "type"     : "lrfile",
		   "repeat"   : "check_box",  
                   "required" : "true",
		   "help"     : "help"
                   },	
 
                 {
                   "role"     : "input",
                   "id"       : "psf_location",
                   "label"    : "PSF file",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },	
 
                 {
                   "role"     : "input",
                   "id"       : "toppar_location",
                   "label"    : "Parameter file (archive)",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },	

                  {
                   "role"     : "input",
                   "id"       : "script_location",
                   "label"    : "Input NAMD script",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "help"
                   },	
                  {
                   "role"     : "input",
                   "id"       : "numproc",
                   "label"    : "Number of Processors",
                   "type"     : "integer",
		   "step"     : 24,
		   "min"      : 24,
		   "max"      : 96,
		   "default"  : 24,   
                   "required" : "true",
                   "help"     : "help"
                   },

#####################################################################################################
                 {
		     "role"    : "output",
		     "id"      : "progress_output",
		     "label"   : "Progress: ",
		     "type"    : "progress",
		     "max"     : 1.0
		 },	
                {
		   "role"    : "output",
                   "id"      : "progress_text",
                   "label"   : "Calculation Report: ",
		   "type"    : "textarea",
                   #"append"  : "on",
                   "cols"    : 40
                  },

	           {
                   "role"  : "output",
                   "id"    : "outputmd",
                   "label" : "MD Simulation Results: ",
                   "type"  : "file",
		   "multiple": "true"    
                  },
	           {
                   "role"  : "output",
                   "id"    : "archivedres",
                   "label" : "Archived Results: ",
                   "type"  : "file"
		   }

	         ],
# the executable will take inputs in order and produce output
    #"executable" : "namdrun.py",
    "executable" : "rinit.sh"
}
