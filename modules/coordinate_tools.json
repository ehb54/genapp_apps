# this is a module file, any module specific info belongs here
{
    "moduleid" : "coordinate_tools",
    "label"    : "Coordinate Tools",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Coordinate Tools",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called coor_tools/ in the directory name you enter here"
                   },

                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "reference pdb",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdb_filename",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdb_filename_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcd_list_box",
                   "name"    : "dcd_list_box",
                   "label"   : "input filename (dcd or pdb)",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "filename",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "name of PDB or DCD file with coordinates you wish to extract structures from",
                   "repeat"   : "dcd_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "filename_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "name of PDB or DCD file with coordinates you wish to extract structures from",
                   "repeat"   : "dcd_list_box:c2",
                   "norow" : "true"
                   },
	          {
                   "role"    : "input",
                   "id"      : "option_list_box",
                   "name"    : "option_list_box",
                   "label"   : "select option",
                   "type"    : "listbox",
                   "values"  : "single frame~c1~range~c2~text file~c3~weight file~c4",
                   "default" : "c1",
		   "help"    : "select either a frame to extract, a range of frames to extract, name of a text file with frame numbers, or a weight file (either 1 or 0 for all frames indicating to extract (1) or ignore (0))",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "local_value_c1",
                   "label"    : "input a single frame number",
                   "type"     : "text",
                   "default"  : "1",
		   "help"     : "supply appropriate value",
		   "repeat"   : "option_list_box:c1"
                   },
                  {
                   "role"     : "input",
                   "id"       : "local_value_c2",
                   "label"    : "input a range of frames",
                   "type"     : "text",
                   "default"  : "3-22",
		   "help"     : "supply appropriate value",
		   "repeat"   : "option_list_box:c2"
                   },
                  {
                   "role"    : "input",
                   "id"      : "text_file_list_box",
                   "name"      : "text_file_list_box",
		   "label"   : " ",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
		   "repeat" : "option_list_box:c3",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "local_value_c3",
                   "label"    : "input name of text file",
                   "type"     : "file",
		   "help"     : "supply appropriate value: file lists desired frames",
		   "repeat"   : "text_file_list_box:c1",
		   "norow"    : "true"
#		   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "local_value_c3_text",
                   "label"    : "input name of text file",
                   "type"     : "text",
                   "default"  : "test.txt",
		   "help"     : "supply appropriate value: file lists desired frames",
		   "repeat"   : "text_file_list_box:c2",
		   "norow"    : "true"
#		   "repeater" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "weight_file_list_box",
                   "name"      : "weight_file_list_box",
		   "label"   : " ",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
		   "repeat" : "option_list_box:c4",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "local_value_c4",
                   "label"    : "input name of weight file",
                   "type"     : "file",
		   "help"     : "supply appropriate value: file is list of weights",
		   "repeat"   : "weight_file_list_box:c1"
                   },
                  {
                   "role"     : "input",
                   "id"       : "local_value_c4_text",
                   "label"    : "input name of weight file",
                   "type"     : "text",
		   "default"  : "run0/generate/x2lowweights.txt",
		   "help"     : "supply appropriate value: file is list of weights",
		   "repeat"   : "weight_file_list_box:c2"
                   },
                  {
                   "role"     : "input",
                   "id"       : "output_filename",
                   "label"    : "output filename (pdb or dcd)",
                   "type"     : "text",
                   "default"  : "output.dcd",
                   "required" : "true",
		   "help"     : "name of file with extracted coordinates"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "coordinate_tools"
}
