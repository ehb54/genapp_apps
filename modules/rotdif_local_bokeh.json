# this is a module file, any module specific info belongs here
{
    "moduleid" : "rotdif_local",
    "label"    : "Calculate",
    #"resource" : "oscluster",
    "submitpolicy" : "login",
    #"help"     : "help for Bead Modeller",
    #"center"   : "true",
    #"centeroutput" : "true",
    #"notify"    : "alexsav.science@gmail.com",
    "notify" : "email",

    
    "fields"   : [

               {
	            "role"       : "input"
	            ,"id"         : "projectname"
	            ,"label"      : "Project name"
	            ,"type"       : "text"
	            ,"required"   : "true"
	            ,"help"       : "Enter a project name"
	            ,"specifiedproject" : "Run_"
	        },
################################################################
	       { 
		   "role"     : "input",  
		   "id"       : "data_label",
		   "label"    : "DATA",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },

                  {
                   "role"     : "input",
                   "id"       : "relax_location",
                   "label"    : "Relaxation File",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "Upload relaxation file"
                   },	
	     
                  {
                   "role"     : "input",
                   "id"       : "pdb_location",
                   "label"    : "PDB File",
                   "type"     : "lrfile",
                   "required" : "true",
		   "help"     : "Upload PDB file"
                   },	

	       { 
		   "role"     : "input",  
		   "id"       : "runmenu_label",
		   "label"    : "RUN MENU",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true",
		   "default"  : ""
	       },

             {
		  "role"     : "input",  
		  "id"       : "optimization_method",
		  "label"    : "Optimization Method",
		  "type"     : "listbox",
		  "values"   : "Least Square~leastsq~Robust Least Square(3.0sig)~robust",
		  "repeater" : "yes",
		  "default"  : "leastsq",
		  "help"     : "Choose optimization method"
	      },

	    {
	        "role"    : "input", 
		"id"      : "stat", 
		"label"   : "Full Statistics ", 
		"type"    : "checkbox", 
		"checked" : "false" 
	    },	



#####################################################################################################
                 {
		     "role"    : "output",
		     "id"      : "progress_output",
		     "label"   : "Progress: ",
		     "type"    : "progress",
		     "max"     : 1.0
		 },	
                {
		   "role"    : "output",
                   "id"      : "progress_text",
                   "label"   : "Calculation Report: ",
		   "type"    : "textarea",
                   #"append"  : "on",
                   "cols"    : 40
                  },

                {
		   "role"    : "output",
                   "id"      : "live_log",
                   "label"   : "Live Log File:  ",
		   "type"    : "html"
                },	

	           {
                   "role"  : "output",
                   "id"    : "outputrotdif",
                   "label" : "Detailed Results File: ",
                   "type"  : "file",
		   "multiple": "true"    
                  }
            
        ,{
            "role"       : "output"
            ,"id"        : "bokehid"
            #,"label"     : "my optional label"
            ,"type"      : "bokeh"
        }

	         ],
# the executable will take inputs in order and produce output
    #"executable" : "rotdif.py"
    "executable" : "rotdif_bokeh.py"
    #,"executable" : "rinit.sh"
}
