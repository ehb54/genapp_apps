            ,"type"     : "text"
            ,"default"    : "-2.00"
            ,"help"       : "minimum c2 value"
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "max_c2"
            ,"label"    : "max c2"
            ,"type"     : "float"
            ,"default"    : 4.00
            ,"help"       : "maximum c2 value"
            ,"repeat"     : "advanced_options"
          }
