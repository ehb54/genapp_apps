            ,"default"    : "false"
            ,"help"       : "fast coarse grained calculation using CA atoms only"
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "offset_FoXS"
            ,"label"    : "use offset"
            ,"type"     : "checkbox"
            ,"default"    : "false"
            ,"help"       : "use offset in fitting"
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "partial_profile_FoXS"
            ,"label"    : "partial profile"
            ,"type"     : "checkbox"
            ,"default"    : "false"
            ,"help"       : "write partial profile file"
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "set_constant_subtractions_FoXS"
            ,"label"    : "background subtractions"
            ,"type"     : "checkbox"
            ,"default"    : "false"
            ,"help"       : "background adjustment, not used by default."
            ,"repeat"     : "advanced_options"
            ,"repeater"  : "true"
          }
        ,{
            "role"       : "input"
            ,"id"       : "constant_subtractions_FoXS"
            ,"label"    : "background subtractions"
            ,"type"     : "float"
            ,"default"    : 0.0
            ,"help"       : "if enabled, recommended value is I(q) for q =  0.2 1//&#8491;"
            ,"repeat"     : "set_constant_subtractions_FoXS"
          }
        ,{
            "role"       : "input"
            ,"id"       : "min_c1"
            ,"label"    : "min c1"
