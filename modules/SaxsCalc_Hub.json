{
    "moduleid" : "SaxsCalc_Hub"
    ,"label"    : "SaxsCalc_Hub"
    ,"executable"   : "saxscalchub"
    ,"submitpolicy" : "all"
#    ,"uniquedir" : "true"
#    ,"center" : "true"
    ,"centeroutput" : "true"
    ,"fields"   : [
        {
            "role"       : "input"
            ,"id"        : "label_0"
            ,"type"      : "label"
            ,"colspan"   : 4
            ,"default"   : "header3"
            ,"label"     : "Multi SAXS Tool *For Academic Use Only*"
            ,"prehline"  : "true"
            ,"posthline" : "true"
        }
        ,{
            "role"       : "input"
            ,"id"         : "pdb"
            ,"label"      : "Input PDB"
# need to force copy over
#            ,"type"       : "lrfile"
            ,"type"       : "file"
            ,"required"   : "true"
            ,"repeater"   : "true"
            ,"help"       : "PDB input file for the complex (required)."
        }
        ,{
            "role"       : "input"
            ,"id"       : "multi_model_pdb"
            ,"label"    : "Multi model pdb"
            ,"type"     : "checkbox"
            ,"default"    : "false"
            ,"help"       : "Choose only if input pdb has multi-frames."
            ,"repeater"   : "true"
            ,"norow"      : "false"
          }
        ,{
            "role"       : "input"
            ,"id"       : "choose_all_models"
            ,"label"    : "Choose all models"
            ,"type"     : "checkbox"
            ,"default"    : "true"
            ,"help"       : "If unchecked, only first MODEL will be calculated except Pepsi-SAXS"
            ,"repeat"     : "multi_model_pdb"
#            ,"norow"      : "true"
          }
        ,{
            "role"       : "input"
            ,"id"         : "set_experimental_curve"
            ,"label"      : "Experimental curve"
#            ,"type"       : "lrfile"
            ,"repeater"   : "true"
            ,"type"       : "checkbox"
            ,"help"       : "Experimental curve (required only for mode 2 and 3)"
        }
        ,{
            "role"       : "input"
            ,"id"         : "experimental_curve"
            ,"label"      : "Input Experimental curve"
#            ,"type"       : "lrfile"
            ,"repeat"     : "set_experimental_curve"
            ,"repeater"   : "true"
            ,"type"       : "file"
            ,"help"       : "Experimental curve (required only for mode 2 and 3)"
        }
        ,{
            "role"       : "input"
            ,"id"       : "angular_units"
            ,"label"    : "Angular units" 
            ,"type"     : "listbox"
            ,"help"       : "Default is 1/A"
            ,"values"     : "q = 1/&#8491;, s = 4&pi; sin(&theta;)/&lambda;~1~q = 1/nm, s = 4&pi; sin(&theta;)/&lambda;~2~q = 1/&#8491;, s = 2sin(&theta;)/&lambda;~3~q = 1/nm, s = 2sin(&theta;)/&lambda;~4"
          }
        ,{
            "role"       : "input"
            ,"id"         : "qmax"
            ,"label"      : "Qmax"
            ,"type"       : "float"
            ,"default"    : 0.5
            ,"help"       : "Maximum scattering vector in inverse angstroms"
        }
        ,{
            "role"       : "input"
            ,"id"         : "number_of_points"
            ,"label"      : "Number of q points"
            ,"type"       : "integer"
            ,"default"    : 500
            ,"info"       : "Number of points in the theoretical curve, need to be determined later"
        }
        ,{   "role"       : "input"
            ,"id"        : "select_all"
            ,"label"     : "Select All Programs"
            ,"type"      : "checkbox"
            ,"checked"   : "true"
            ,"repeater"  : "true"
            ,"colspan"   : 4 
            ,"prehline"  : "true"
            ,"posthline" : "true"
        }
        ,{
            "role"       : "input"
            ,"id"         : "CRYSOL"
            ,"label"      : "CRYSOL[<a href=https://www.embl-hamburg.de/biosaxs/crysol.html target=_blank>1</a>]"
            ,"type"       : "checkbox"
            ,"checked"    : "true"
            ,"repeat"     : "select_all"
            ,"repeater"   : "true"
            ,"help"       : "If unchecked, CRYSOL will be excluded"
        }
        ,{
            "role"       : "input"
            ,"id"         : "FoXS"
            ,"label"      : "FoXS[<a href=https://modbase.compbio.ucsf.edu/foxs/about.html target=_blank>1</a>]"
            ,"type"       : "checkbox"
            ,"checked"    : "true"
            ,"repeater"   : "true"
            ,"repeat"     : "select_all"
            ,"help"       : "If unchecked, FoXS will be excluded"
        }
        ,{
            "role"       : "input"
            ,"id"         : "Pepsi_SAXS"
            ,"label"      : "Pepsi-SAXS[<a href=https://team.inria.fr/nano-d/software/pepsi-saxs target=_blank>1</a>]"
            ,"type"       : "checkbox"
            ,"checked"    : "true"
            ,"repeater"   : "true"
            ,"repeat"     : "select_all"
            ,"help"       : "If unchecked, Pepsi_SAXS will be excluded"
        }
        ,{
            "role"       : "input"
            ,"id"         : "SASTBX"
            ,"label"      : "SASTBX[<a href=https://sastbx-document.readthedocs.io/en/latest target=_blank>1</a>]"
            ,"type"       : "checkbox"
            ,"checked"    : "true"
            ,"repeater"   : "true"
            ,"repeat"     : "select_all"
            ,"help"       : "If unchecked, SASTBX will be excluded"
        }        

        ,{
            "role"       : "input"
            ,"id"         : "sascalc_hub"
            ,"label"      : "SasCalc[<a href=https://www.sciencedirect.com/science/article/pii/S0010465511003286 target=_blank>1</a>],[<a href=https://sassie-jetstream.genapp.rocks/sassie2/docs/calculate/sascalc/sascalc.html target=_blank>2</a>]"
            ,"type"       : "checkbox"
            ,"checked"    : "false"
            ,"repeater"   : "true"
            ,"repeat"     : "select_all"
            ,"help"       : "Not supported yet"
        }
        ,{
            "role"       : "input"
            ,"id"         : "WAXSiS"
            ,"label"      : "WAXSiS[<a href=http://waxsis.uni-goettingen.de target=_blank>1</a>]"
            ,"type"       : "checkbox"
            ,"checked"    : "false"
            ,"repeater"   : "true"
            ,"repeat"     : "select_all"
            ,"help"       : "Not supported yet"
        }
        ,{
            "role"       : "input"
            ,"id"         : "SoftWAXS"
            ,"label"      : "SoftWAXS[<a href=https://bitbucket.org/bardhanlab/softwaxs target=_blank>1</a>]"
            ,"type"       : "checkbox"
            ,"checked"    : "false"
            ,"repeater"   : "true"
            ,"repeat"     : "select_all"
            ,"help"       : "Not supported yet"
        }
        ,{
            "role"       : "input"
            ,"id"         : "AXES"
            ,"label"      : "AXES[<a href=https://spin.niddk.nih.gov/bax/nmrserver/saxs1/ target=_blank>1</a>]"
            ,"type"       : "checkbox"
            ,"checked"    : "false"
            ,"repeater"   : "true"
            ,"repeat"     : "select_all"
            ,"help"       : "Not supported yet"
        }
        ,{
            "role"       : "input"
            ,"id"       : "advanced_options"
            ,"type"     : "checkbox"
            ,"label"    : "Advanced Options"
            ,"checked"  : "false"
            ,"prehline"  : "true"
            ,"posthline"  : "true"
            ,"repeater" : "true"
            ,"help"       : "check to setup advanced options of selected program(s)"
          }
        ,{
            "role"       : "input"
            ,"id"       : "debug_msg"
            ,"label"    : "Debugging mode"
            ,"type"     : "checkbox"
            ,"checked"    : "false"
            ,"help"       : "Check to activate debugging messages"
#            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"         : "explicit_water"
            ,"label"      : "Explicit water model [Not supported yet]"
            ,"type"       : "checkbox"
            ,"checked"    : "false"
            ,"repeat"     : "advanced_options"
            ,"help"       : "Explicit hydration for SAXS calculation"
        }
        ,{
            "role"       : "input"
            ,"id"         : "explicit_hydrogen"
            ,"label"      : "Use explicit hydrogens [only CRYSOL, FoXS, Pepsi-SAXS]"
            ,"type"       : "checkbox"
            ,"checked"    : "false"
            ,"repeat"     : "advanced_options"
            ,"help"       : "Explicit hydrogens for SAXS calculation"
        }
        ,{
            "role"       : "input"
            ,"id"         : "constant_subtractions"
            ,"label"      : "Background subtractions [only CRYSOL, Pepsi-SAXS]"
            ,"type"       : "checkbox"
            ,"checked"    : "false"
            ,"repeat"     : "advanced_options"
            ,"help"       : "Substract a constant factor if experimental data contains a systematic error"
        }

##################################################################################
####     Full Options for CRYSOL
##################################################################################
        ,{  
            "role"       : "input"
            ,"id"       : "fulloptions_CRYSOL"
            ,"label"    : "CRYSOL specific"
            ,"type"     : "label"
            ,"checked"    : "false"
            ,"help"       : "Check to modify CRYSOL options"
            ,"repeat"     : "advanced_options"
            ,"prehline"  : "true"
            ,"posthline"  : "true"
#            ,"repeater"   : "true"
          }
        ,{
            "role"       : "input"
            ,"id"       : "optional_outputs"
            ,"label"    : "optional outputs"
            ,"type"     : "checkbox"
            ,"default"    : "false"
            ,"help"       : "(i) in prediction mode: *.sav and *.flm (ii) in fitting mode: *.int, *.alm, *.sav and *.flm."
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "write_error"
            ,"label"    : "write error"
            ,"type"     : "checkbox"
            ,"default"    : "false"
            ,"help"       : "Write experimental errors to the .fit file (Y or N)."
            ,"repeat"     : "advanced_options"
          }
        ,{  
            "role"       : "input"
            ,"id"       : "read_old_pdb"
            ,"label"    : "pdb with old atom naming"
            ,"type"     : "checkbox"
            ,"default"    : "false" 
            ,"help"       : "Read a PDB file with an old atom naming (pre 2008)."
            ,"repeat"     : "advanced_options"
          }

       ,{
            "role"       : "input"
            ,"id"       : "maxharmonics"
            ,"label"    : "maximum number of harmonics"
            ,"type"     : "integer"
            ,"default"    : 15
            ,"help"       : "Choose integer between 1 and 50"
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "fibonacci_grid"
            ,"label"    : "fibonacci grid"
            ,"type"     : "integer"
            ,"default"    : 17
            ,"help"       : "Choose integer between 10 and 17"
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "solvent_density"
            ,"label"    : "solvent density"
            ,"type"     : "float"
            ,"default"    : 0.334
            ,"help"       : "Solvent density (e/A^3). Default value is the electron density of pure water." 
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "contrast_hydration"
            ,"label"    : "contrast of hydration shell"
            ,"type"     : "float"
            ,"default"    : 0.03
            ,"help"       : "in unit of (e/&#8491;^3)"
            ,"repeat"     : "advanced_options"
          }
        ,{
            "role"       : "input"
            ,"id"       : "set_chain_id"
            ,"label"    : "chain identifier"
            ,"type"     : "checkbox"
            ,"default"    : "false"
            ,"help"       : "Click to speicify chain(s) in input pdb for calculation"
            ,"repeat"     : "advanced_options"
            ,"repeater"   : "true"
          }
        ,{
            "role"       : "input"
            ,"id"       : "chain_id"
            ,"label"    : "chain identifier"
            ,"type"     : "text"
            ,"default"    : "A"
            ,"help"       : "By default, all chains are processed. If there is _ before chain identifier, all chains except for specified will be processed."
            ,"repeat"     : "set_chain_id"
          }
##################################################################################
####     Full Options for FoXS
##################################################################################
        ,{
            "role"       : "input"
            ,"id"       : "fulloptions_FoXS"
            ,"label"    : "FoXS specific"
