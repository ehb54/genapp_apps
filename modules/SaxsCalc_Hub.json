            ,"repeater"   : "true"
            ,"type"       : "checkbox"
            ,"help"       : "Experimental curve (required only for mode 2 and 3)"
        }
        ,{
            "role"       : "input"
            ,"id"         : "experimental_curve"
            ,"label"      : "Input Experimental curve"
# need to force copy over
