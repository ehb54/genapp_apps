            ,"default"   : "header3"
            ,"label"     : "Multi SAXS Tool *For Academic Use Only*"
            ,"prehline"  : "true"
            ,"posthline" : "true"
        }
        ,{
            "role"       : "input"
            ,"id"         : "pdb"
            ,"label"      : "Input PDB"
# need to force copy over
