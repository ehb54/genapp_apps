# this is a module file, any module specific info belongs here
{
    "moduleid" : "complex_monte_carlo",
    "label"    : "Complex Monte Carlo",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Complex Monte Carlo",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "project name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "reference pdb",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile",
                   "label"   : " ",
                   "type"    : "file",
                   "required" : "true",
                   "help"     : "PDB file containing initial coordinates",
                   "repeat"   : "refpdb_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "pdbfile_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "help"     : "PDB file containing initial coordinates",
                   "repeat"   : "refpdb_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile",
                   "label"    : "output file name (dcd)",
                   "type"     : "text",
                   "default"  : "run_0.dcd",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "trials",
                   "label"    : "number of trial attempts",
                   "type"     : "text",
                   "default"  : "20",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "goback",
                   "label"    : "return to previous structure",
                   "type"     : "text",
                   "default"  : "20",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "temp",
                   "label"    : "temperature (K)",
                   "type"     : "text",
                   "default"  : "300.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "complex_specific_input_header",
                   "label"    : "Complex Specific Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline" : "true",
                   "posthline": "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "nsegments",
                   "label"    : "Enter TOTAL number of segements:",
                   "type"     : "text",
                   "default"  : "2",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "segbasis",
                   "label"    : "segment overlap basis",
                   "type"     : "text",
                   "default"  : "CA,CA",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "npsegments",
                   "label"    : "number of flexible segments:",
                   "type"     : "integer",
                   "default"  : 2,
                   "required" : "true",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "flpsegname",
                   "label"    : "segment name(s) of flexible segments",
                   "type"     : "text",
                   "default"  : "ENDA,ENDB",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "seglow",
                   "label"    : "structure alignment: low residue",
                   "type"     : "text",
                   "default"  : "95,95",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "seghigh",
                   "label"    : "structure alignment: high residue",
                   "type"     : "text",
                   "default"  : "110,110",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numranges",
                   "label"    : "number of flexible regions to vary",
                   "type"     : "text",
                   "default"  : "2",
                   "required" : "false",
                   "repeat"   : "npsegments",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sith",
                   "label"    : "enter MAX [dtheta] for each region",
                   "type"     : "text",
                   "default"  : "30.0,30.0",
                   "required" : "false",
                   "repeat"   : "npsegments",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "srlow",
                   "label"    : "first residue per region",
                   "type"     : "text",
                   "default"  : "123,277",
                   "required" : "false",
                   "repeat"   : "npsegments",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "srnum",
                   "label"    : "number contiguous residues per region",
                   "type"     : "text",
                   "default"  : "21,5",
                   "required" : "false",
                   "repeat"   : "npsegments",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "moltype",
                   "label"    : "molecule type (protein or rna)",
                   "type"     : "listbox",
                   "values"   : "dna~c1~rna~c2~protein~c3",
                   "default"  : "c3",
                   "required" : "false",
                   "repeat"   : "npsegments",
                   "norow"    : "true"
                   },
                   {
                   "role"       : "input",
                   "id"       : "advanced_input_header",
                   "label"    : "Advanced Input",
                   "type"     : "label",
                   "default"  : " ",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "advanced_input",
                   "label"    : "Check Box for Advanced Input",
                   "type"     : "checkbox",
                   "checked"  : "false",
                   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "basis",
                   "label"    : "flexible segment overlap basis",
                   "type"     : "text",
                   "default"  : "CA",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "cutoff",
                   "label"    : "overlap cutoff",
                   "type"     : "text",
                   "default"  : "3.0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "lowrg",
                   "label"    : "low Rg cutoff",
                   "type"     : "text",
                   "default"  : "0.0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "highrg",
                   "label"    : "high Rg cutoff",
                   "type"     : "text",
                   "default"  : "300.0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
		  {
                   "role"    : "input",
                   "id"      : "zflag_list_box",
                   "name"    : "zflag_list_box",
                   "label"    : "Z coordinate filter", 
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "c1",
                   "repeat"  : "advanced_input"
                   },
                  {
                   "role"     : "input",
                   "id"       : "zcutoff",
                   "label"    : "Z cutoff (angstroms)",
                   "type"     : "text",
                   "default"  : "0.0",
                   "required" : "true",
                   "repeat"  : "advanced_input"
                   },
		  {
                   "role"    : "input",
                   "id"      : "cflag_list_box",
                   "name"    : "cflag_list_box",
                   "label"    : "check box to use atomic constraints",
                   "type"    : "checkbox",
                   "checked" : "false",
                   "repeat"  : "advanced_input",
		   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "confile",
                   "label"    : "constraint file name",
                   "type"     : "file",
                   "required" : "false",
		   "default"  : "contraints.txt",
                   "repeat"  : "cflag_list_box"
                   },
		  {
                   "role"    : "input",
                   "id"      : "plotflag_list_box",
                   "name"    : "plotflag_list_box",
                   "label"    : "plot Rg during run",
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "c1",
                   "repeat"  : "advanced_input"
                   },
                   {
                   "role"    : "output",
                   "id"      : "plotout4",
                   "label"   : "all rg and accepted rg data",
                   "type"    : "plot2d"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "complex_monte_carlo"
}
