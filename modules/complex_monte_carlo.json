# this is a module file, any module specific info belongs here
{
    "moduleid" : "complex_monte_carlo",
    "label"    : "Complex Monte Carlo",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Complex Monte Carlo",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called generate/ in the directory name you enter here"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "input file name (pdb)",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile",
                   "label"    : "output file name (dcd)",
                   "type"     : "text",
                   "default"  : "run_0.dcd",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "trials",
                   "label"    : "number of trial attempts",
                   "type"     : "text",
                   "default"  : "100",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "goback",
                   "label"    : "return to previous structure",
                   "type"     : "text",
                   "default"  : "20",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "temp",
                   "label"    : "temperature (K)",
                   "type"     : "text",
                   "default"  : "300.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "moltype",
                   "label"    : "molecule type (protein or rna)",
                   "type"     : "text",
                   "default"  : "protein",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numranges",
                   "label"    : "number of flexible regions to vary",
                   "type"     : "text",
                   "default"  : "5",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dtheta",
                   "label"    : "enter MAX [dtheta] for each region",
                   "type"     : "text",
                   "default"  : "30.0,30.0,30.0,30.0,30.0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "reslow",
                   "label"    : "first residue per region",
                   "type"     : "text",
                   "default"  : "123,277,354,378,408",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "numcont",
                   "label"    : "number contiguous residues per region",
                   "type"     : "text",
                   "default"  : "21,5,20,11,4",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "lowres1",
                   "label"    : "structure alignment: low residue",
                   "type"     : "integer",
                   "default"  : 284,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "highres1",
                   "label"    : "structure alignment: high residue",
                   "type"     : "integer",
                   "default"  : 350,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "basis",
                   "label"    : "overlap basis",
                   "type"     : "text",
                   "default"  : "CA",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "cutoff",
                   "label"    : "overlap cutoff",
                   "type"     : "float",
                   "default"  : 3.0,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "lowrg",
                   "label"    : "low Rg cutoff",
                   "type"     : "float",
                   "default"  : 0.0,
                   "min"      : 0.0,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "highrg",
                   "label"    : "high Rg cutoff",
                   "type"     : "float",
                   "default"  : 300.0,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "zflag",
                   "label"    : "Z coordinate filter (0==no, 1==yes)",
                   "type"     : "integer",
                   "default"  : 0,
	           "min"      : 0,
		   "max"      : 1,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "zcutoff",
                   "label"    : "Z cutoff (angstroms)",
                   "type"     : "float",
                   "default"  : 0.0,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "cflag",
                   "label"    : "atomic constraints (0==no, 1==yes)",
                   "type"     : "integer",
                   "default"  : 0,
	           "min"      : 0,
		   "max"      : 1,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "confile",
                   "label"    : "constraint file name",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "nonbondflag",
                   "label"    : "non-bonding energies (0==no, 1==yes)",
                   "type"     : "integer",
                   "default"  : 0,
	           "min"      : 0,
		   "max"      : 1,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "nonbondscale",
                   "label"    : "non-bonding scale factor",
                   "type"     : "float",
                   "default"  : 1.0,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "psffilename",
                   "label"    : "psf file name",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "plotflag",
                   "label"    : "plot Rg during run (0==no, 1==yes)",
                   "type"     : "integer",
                   "default"  : 0,
	           "min"      : 0,
		   "max"      : 1,
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "directedmc",
                   "label"    : "directed Monte Carlo (0==no or Rg value)",
                   "type"     : "text",
                   "default"  : "0",
                   "required" : "true"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "complex_monte_carlo"
}
