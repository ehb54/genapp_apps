# this is a module file, any module specific info belongs here
{
    "moduleid" : "mulch_contrast",
    "label"    : "Contrast",
    "help"     : "help for Contrast",
    #"extendedjsoninputtags" : "true",
    "fields"   : [
               {
	            "role"        : "input"
	            ,"id"         : "projectname"
	            ,"label"      : "Project name"
	            ,"type"       : "text"
	            ,"required"   : "true"
	            ,"help"       : "Enter a project name"
	            ,"specifiedproject" : "Run_"
	        },

#### Project Title ###############################################
	         {
                   "role"     : "input",
                   "id"       : "title",
                   "label"    : "Project Title",
                   "type"     : "text",
		   "required" : "true",
		   "size"     : 50,   
		   "pattern"  : ""
		 },	
################################################################

	         {
                   "role"     : "input",
                   "id"       : "contrast_file",
                   "label"    : "Upload Contrast File",
                   "type"     : "lrfile",
		   "setinputfromfile":"whitespace_formulchcontrast",
		   "setinputfromfileids":"title,contrast_points_num,num_species_solv,proton_frac_1,deuter_level_1,num_subunit_1,proton_frac_2,deuter_level_2,num_subunit_2", 
                   "help"     : ""
                   },

#### Contrast Points ###############################################
		  { 
		   "role"     : "input",  
		   "id"       : "contrast_label",
		   "label"    : "CONTRAST POINTS",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true"
	          },	
		  { 
		   "role"     : "input",  
		   "id"       : "contrast_check",
		   "label"    : "Use Contrast Points?",
		   "type"     : "checkbox",
		   "checked"  : "true",   
		   "repeater" : "true",   
		   "required" : "true"
		  },		
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num",
                   "label"    : "Number of Contrast Points:",
                   "type"     : "integer",
		   "tableize" : "true",  
		   "repeat"   : "contrast_check",  
		   "repeater" : "true",   
		   "required" : "true",
		   "default"  : 3,
		   "min"      : 3,
		   "max"      : 15  
                  },
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_fdo2",
                   "label"    : "<center><i>f</i><sub>D<sub>2</sub>O</sub>(0-1)</center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num",   
		   "required" : "true",
		   "default"  : 0,
		   "norow"    : "true",
		   "size"     : 4,   
		   "pattern"  : "^((0([.][0-9]*)?)|(1([.]00)?))$"
		 },
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_i_0",
                   "label"    : "<center><i>I</i>(0)</center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num",   
		   "required" : "true",
		   "default"  : 0,
		   "min"      : 0,
		   "norow"    : "true",
		    "size"     : 4,   
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },

	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_sig_i_0",
                   "label"    : "<center><i>&sigma;</i>[<i>I</i>(0)]</center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num",   
		   "required" : "true",
		   "default"  : 0,
		   "min"      : 0,
		   "norow"    : "true",
		   "size"     : 4,  
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },

	         {
                   "role"     : "input",
                   "id"       : "contrast_points_prot_conc",
                   "label"    : "<center>Protein Conc.</center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num",   
		   "required" : "true",
		   "default"  : 0,
		   "min"      : 0,
		   "size"     : 4, 
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },	

### Dissolved Species #######################################	
		  { 
		   "role"     : "input",  
		   "id"       : "dissspec_label",
		   "label"    : "DISSOLVED SPECIES",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true"
		  },
	         {
                   "role"     : "input",
                   "id"       : "num_species_solv",
                   "label"    : "Number of Dissolved Species in the Solvent",
                   "type"     : "integer",
		   #"tableize" : "true",  
		   "repeater" : "true",   
		   "required" : "true",
		   "default"  : 0,
		   "min"      : 0,
		   "max"      : 6  
                  },
	         {
                   "role"     : "input",
                   "id"       : "num_species_solv_substance_type",
                   "label"    : "Substance Type:",
                   "type"     : "listbox",
		   "repeat"   : "num_species_solv", 
		   "required" : "true",
		   #"norow"    : "true",  
		   "values"   : "Protein~P~DNA~D~RNA~R~Molecule~M",
		   "default"  : "molecule"
		     #,"norow"  : "true"
		 },	
	         {
                   "role"     : "input",
                   "id"       : "num_species_solv_formula",
                   "label"    : "Formula:",
                   "type"     : "textarea",
		   "repeat"   : "num_species_solv", 
		   "required" : "true",
		   "norow"    : "true",
		   "size"     : 8,
		   "pattern"  : ""
		 },
	         {
                   "role"     : "input",
                   "id"       : "num_species_solv_conc",
                   "label"    : "Concentration:",
                   "type"     : "text",
		   "repeat"   : "num_species_solv", 
		   "required" : "true",
		   "norow"    : "true",
		   "size"     : 5,  
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },	
	         {
                   "role"     : "input",
                   "id"       : "num_species_solv_vol",
                   "label"    : "Volume:",
                   "type"     : "text",
		   "repeat"   : "num_species_solv", 
		   "required" : "true",
		   "size"     : 5,   
		   "default"  : "0.0",
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },

###### Subunit Components 1 ##################################
		  { 
		   "role"     : "input",  
		   "id"       : "unit1_label",
		   "label"    : "SUBUNIT 1",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true"
		  },	
	         { 
                   "role"     : "input",
                   "id"       : "deuter_level_1",
                   "label"    : "Deuteration level (0-1)",
                   "type"     : "text",
		   "required" : "true",
		   "size"     : 5,   
		   "default"  : "0.0",
		   "pattern"  : "^((0([.][0-9]*)?)|(1([.]00)?))$"  
		 },
	         {
                   "role"     : "input",
                   "id"       : "proton_frac_1",
                   "label"    : "Fraction of acidic protons accessible by the solvent",
                   "type"     : "text",
		   "required" : "true",
		   "size"     : 5,   
		   "default"  : "0.0",
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },	

	         {
                   "role"     : "input",
                   "id"       : "num_subunit_1",
                   "label"    : "Number of Components in Subunit 1",
                   "type"     : "integer",
		   "repeater" : "true",   
		   "required" : "true",
		   "default"  : 1,
		   "min"      : 1,
		   "max"      : 6  
                  },	
	         {
                   "role"     : "input",
                   "id"       : "num_subunit_1_substance_type",
                   "label"    : "Substance Type:",
                   "type"     : "listbox",
		   "repeat"   : "num_subunit_1", 
		   "required" : "true",
		   "values"   : "Protein~P~DNA~D~RNA~R~Molecule~M",
		   "default"  : "molecule"
		     #,"norow"  : "true"
		 },	
	         {
                   "role"     : "input",
                   "id"       : "num_subunit_1_formula",
                   "label"    : "Formula:",
                   "type"     : "textarea",
		   "repeat"   : "num_subunit_1", 
		   "required" : "true",
		   "norow"    : "true",
		   "size"     : 8,
		   "pattern"  : ""
		 },
	         {
                   "role"     : "input",
                   "id"       : "num_subunit_1_num_molecules",
                   "label"    : "N_molecules:",
                   "type"     : "text",
		   "repeat"   : "num_subunit_1", 
		   "required" : "true",
		   "norow"    : "true",
		   "size"     : 5,  
		   "default"  : "1", 
		   "pattern"  : "^(0|[1-9][0-9]?)$"  
		 },	
	         {
                   "role"     : "input",
                   "id"       : "num_subunit_1_vol",
                   "label"    : "Volume:",
                   "type"     : "text",
		   "repeat"   : "num_subunit_1", 
		   "required" : "true",
		   "size"     : 5,   
		   "default"  : "0.0",
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },

###### Subunit Components 2 ##################################
		  { 
		   "role"     : "input",  
		   "id"       : "unit2_label",
		   "label"    : "SUBUNIT 2",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true"
		  },	
	         {
                   "role"     : "input",
                   "id"       : "deuter_level_2",
                   "label"    : "Deuteration level (0-1)",
                   "type"     : "text",
		   "required" : "true",
		   "size"     : 5,   
		   "default"  : "0.0",
		   "pattern"  : "^((0([.][0-9]*)?)|(1([.]00)?))$"  
		 },
	         {
                   "role"     : "input",
                   "id"       : "proton_frac_2",
                   "label"    : "Fraction of acidic protons accessible by the solvent",
                   "type"     : "text",
		   "required" : "true",
		   "size"     : 5,   
		   "default"  : "0.0",
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },	

	         {
                   "role"     : "input",
                   "id"       : "num_subunit_2",
                   "label"    : "Number of Components in Subunit 2",
                   "type"     : "integer",
		   "repeater" : "true",   
		   "required" : "true",
		   "default"  : 1,
		   "min"      : 1,
		   "max"      : 6  
                  },	
	         {
                   "role"     : "input",
                   "id"       : "num_subunit_2_substance_type",
                   "label"    : "Substance Type:",
                   "type"     : "listbox",
		   "repeat"   : "num_subunit_2", 
		   "required" : "true",
		   "values"   : "Protein~P~DNA~D~RNA~R~Molecule~M",
		   "default"  : "molecule"
		     #,"norow"  : "true"
		 },	
	         {
                   "role"     : "input",
                   "id"       : "num_subunit_2_formula",
                   "label"    : "Formula:",
                   "type"     : "textarea",
		   "repeat"   : "num_subunit_2", 
		   "required" : "true",
		   "norow"    : "true",
		   "size"     : 8,
		   "pattern"  : ""
		 },
	         {
                   "role"     : "input",
                   "id"       : "num_subunit_2_num_molecules",
                   "label"    : "N_molecules:",
                   "type"     : "text",
		   "repeat"   : "num_subunit_2", 
		   "required" : "true",
		   "norow"    : "true",
		   "size"     : 5,  
		   "default"  : "1", 
		   "pattern"  : "^(0|[1-9][0-9]?)$"
		 },	
	         {
                   "role"     : "input",
                   "id"       : "num_subunit_2_vol",
                   "label"    : "Volume:",
                   "type"     : "text",
		   "repeat"   : "num_subunit_2", 
		   "required" : "true",
		   "size"     : 5,   
		   "default"  : "0.0",
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },

###### OUTPUT ##################################################
                  {
                   "role"  : "output",
                   "id"    : "outputfile",
                   "label" : "HTML:",
                   "type"  : "file"
                   },	
                 {
                   "role"  : "output",
                   "id"    : "output_html_label",
                   "label" : "OUTPUT HTML",
		   "prehline" : "true",
		   "posthline": "true",
                   "type"  : "label"
                   },	
	
                  {
                   "role"  : "output",
                   "id"    : "output_html",
                   "label" : "",
                   "type"  : "html"
                   }	
	],
# the executable will take inputs in order and produce output
    "executable"   : "contrast.py",
    "submitpolicy" : "all"
}

