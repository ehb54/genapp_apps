{
    "moduleid" : "ift"
    ,"label"    : "BayesApp"
    ,"executable"   : "ift"
    ,"submitpolicy" : "all"
#    ,"uniquedir" : "true"
    ,"fields"   : [
        {
            "role"       : "input"
            ,"id"        : "label_0"
            ,"type"      : "label"
            ,"colspan"   : 3
            ,"default"   : "header3"
            ,"label"     : "Ift"
            ,"prehline"  : "true"
            ,"posthline" : "true"
            ,"help"      : "For more details see J. Appl. Cryst. (2013) 46, 1884"
        }
        ,{
            "role"       : "input"
            ,"id"         : "datafile"
            ,"label"      : "Data file"
# need to force copy over
#            ,"type"       : "lrfile"
            ,"type"       : "file"
            ,"required"   : "true"
            ,"help"       : "<p>i): Format (q, I(q), error). Data points are rebinned to a maximum of 80 points.</p><p>ii): Text lines in the data file are ignored.</p><p>iii): Maximum dynamic range for I(q) is about 1000 using the web version due to the limited resolution of p(r).</p>"
        }
        ,{
            "role"       : "input"
            ,"id"         : "qmin"
            ,"label"      : "Qmin [Angstrom^-1]"
            ,"type"       : "float"
            ,"min"        : 0.05
            ,"max"        : 1.0
            ,"help"       : "Optionally enter q min in inverse Angstroms"
        }
        ,{
            "role"       : "input"
            ,"id"         : "qmax"
            ,"label"      : "Qmax [Angstrom^-1]"
            ,"type"       : "float"
            ,"min"        : 0.05
            ,"max"        : 1.0
            ,"default"    : 0.25
            ,"help"       : "Qptionally Enter q max in inverse Angstroms"
        }
        ,{
            "role"       : "input"
            ,"id"         : "dmax"
            ,"label"      : "Dmax [Angstrom]"
            ,"type"       : "float"
            ,"min"        : 1
            ,"max"        : 1e4
            ,"help"       : "Optionally enter Dmax in Angstroms"
        }
        ,{
            "role"       : "input"
            ,"id"         : "dmaxfixed"
            ,"label"      : "Fix Dmax"
            ,"type"       : "checkbox"
            ,"help"       : "Fix the defined Dmax"
        }
        ,{
            "role"       : "input"
            ,"id"         : "eta"
            ,"label"      : "Eta"
            ,"type"       : "float"
            ,"help"       : "Optionally enter Eta"
            ,"norow"      : "true"
        }
        ,{
            "role"       : "input"
            ,"id"         : "alpha"
            ,"label"      : "Starting value for the Lagrange multiplier (Alpha)"
            ,"type"       : "float"
            ,"help"       : "<p>Optionally enter the starting value for the logarithm of the Lagrange multiplier (usually between -10 and 20).</p><p>Larger values will give smoother distributions or - for the MaxEnt constraint: an estimate which is closer to the prior ellipsoid of revolution.</p>"
            ,"norow"      : "true"
        }
        ,{
            "role"       : "input"
            ,"id"         : "dmaxfixed"
            ,"label"      : "Fix Dmax"
            ,"type"       : "checkbox"
            ,"help"       : "Fix the Lagrange multiplier"
        }
        ,{
            "role"       : "input"
            ,"id"         : "smearing"
            ,"label"      : "Desmearing constant"
            ,"type"       : "float"
            ,"help"       : "<p>Optionally enter a correction for slit smearing. Default is no smearing.</p><p>Enter value for constant c as given by the expression</p><p>I_smear(q) = integrate P(t)*I(sqrt(q**2 + t**2)) dt with the</p><p>primary beam length profile: P(t) = c/sqrt(pi) * exp(-c**2*t**2).</p><p>The fit and the deconvolution are both given in the ouput file fit.d</p>"
        }
        ,{
            "role"       : "input"
            ,"id"         : "nondilute"
            ,"label"      : "Non-dilute solution"
            ,"type"       : "checkbox"
            ,"repeater"   : "true"
            ,"help"       : "Check for non-dilute solutions"
        }
        ,{
            "role"       : "input"
            ,"id"         : "fitratio"
            ,"label"      : "Fit axial ratio method"
            ,"type"       : "listbox"
            ,"values"     : "No concentration effects~noconceffects~Moment~moment~No~no~Evidence~evidence"
            ,"help"       : "Optionally enter the method" 
        }
        ,{
            "role"       : "input"
            ,"id"         : "estimateratio"
            ,"label"      : "Estimate the axial ratio"
            ,"type"       : "float"
            ,"repeat"     : "nondilute"
            ,"help"       : "Optionally enter an estimate of the axial ratio"
            ,"norow"      : "true"
        }
        ,{
            "role"       : "input"
            ,"id"         : "estimateratiofixed"
            ,"label"      : "Fix the estimated axial ratio"
            ,"type"       : "checkbox"
            ,"repeat"     : "nondilute"
            ,"help"       : "Fix the estimated axial ratio"
        }
    ]
}
