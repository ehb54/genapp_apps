# this is a module file, any module specific info belongs here
{
    "moduleid" : "data_interpolation",
    "label"    : "Data_interpolation",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Data Interpolation",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called interpolate/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "data_file_list_box",
                   "name"    : "data_file_list_box",
                   "label"   : "experimental data file",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input", 
                   "id"      : "expdata",
                   "label"    : "input data file",
                   "type"    : "file",
                   "required" : "true",
                   "repeat"   : "data_file_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"    : "input", 
                   "id"      : "expdata_text",
                   "label"   : "enter full path and file name ",
                   "type"    : "text",
                   "required" : "true",
                   "repeat"   : "data_file_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "ofile",
                   "label"    : "output file name",
                   "type"     : "text",
                   "default"  : "caw_0p6mgml.dat",
                   "required" : "true"
                   },
                  {
                   "role"       : "input",
                   "id"       : "io",
                   "label"    : "I(0)",
                   "type"     : "float",
                   "default"  : 0.011,
#                   "min"      : 0.0,
#                   "max"      : 1e50,
                   "required" : "true"
                   },
                  {
                   "role"       : "input",
                   "id"       : "ioe",
                   "label"    : "I(0) error",
                   "type"     : "float",
                   "default"  : 0.001,
                   "required" : "true"
                   },
                  {
                   "role"       : "input",
                   "id"       : "dq",
                   "label"    : "new delta q",
                   "type"     : "float",
                   "default"  : 0.01,
                   "required" : "true"
                   },
                  {
                   "role"       : "input",
                   "id"       : "maxpoints",
                   "label"    : "number of new q-values",
                   "type"     : "integer",
                   "default"  : 30,
                   "required" : "true"
                   },
                   {
                   "role"    : "output",
                   "id"      : "plotout4",
                   "label"   : "original and interpolated data",
                   "type"    : "plot2d"
                   },
		   {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : "",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		    }
                  ],
# the executable will take inputs in order and produce output
    "executable" : "data_interpolation"
}
