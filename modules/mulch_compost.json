# this is a module file, any module specific info belongs here
{
    "moduleid" : "mulch_compost",
    "label"    : "Compost",
    "help"     : "help for Contrast",
    #"backgroundimage" : "Nanodisc-new.png",
    "nowrap"   : "true",
    "fields"   : [
               {
	            "role"        : "input"
	            ,"id"         : "projectname"
	            ,"label"      : "Project name"
	            ,"type"       : "text"
	            ,"required"   : "true"
	            ,"help"       : "Enter a project name"
	            ,"specifiedproject" : "Run_"
	        },

#### Project Title ###############################################
	         {
                   "role"     : "input",
                   "id"       : "title",
                   "label"    : "Project Title",
                   "type"     : "text",
		   "required" : "true",
		   "size"     : 50,   
		   "pattern"  : ""
		 },	
################################################################

	         {
                   "role"     : "input",
                   "id"       : "contrast_file",
                   "label"    : "Upload Compost FILE",
                   "type"     : "lrfile",
		   "setinputfromfile":"whitespace_formulchcompost",
		   "setinputfromfileids":"title,contrast_points_num_compost,upper_qr_limit",
                   "help"     : ""
                   },

#### Contrast Values  ###############################################
		  { 
		   "role"     : "input",  
		   "id"       : "contrast_val_label",
		   "label"    : "CONTRAST VALUES (opt)",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true"
	          },
	         {
                   "role"     : "input",
                   "id"       : "vol_1",
                   "label"    : "Vol<sub>1</sub>(&#8491)",
                   "type"     : "text",
		   "required" : "false",
		   "norow"    : "true",
		   "size"     : 4,   
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
		 },
	
	         {
                   "role"     : "input",
                   "id"       : "delta_rho_1",
                   "label"    : "<i>&Delta;&rho;</i><sub>1</sub>=",
                   "type"     : "text",
		   "required" : "false",
		   "norow"    : "true",
		   "size"     : 4,   
		   "pattern"  : "^[-]?(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
		 },
	         {
                   "role"     : "input",
                   "id"       : "fdo2_1",
                   "label"    : "<i>f</i><sub>D<sub>2</sub>O</sub>+",
                   "type"     : "text",
		   "required" : "false",
		   "norow"    : "false",
		   "size"     : 4,   
		   "pattern"  : "^[-]?(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
		 },

	
	         {
                   "role"     : "input",
                   "id"       : "vol_2",
                   "label"    : "Vol<sub>2</sub>(&#8491)",
                   "type"     : "text",
		   "required" : "false",
		   "norow"    : "true",
		   "size"     : 4,   
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
		 },

                {
                   "role"     : "input",
                   "id"       : "delta_rho_2",
                   "label"    : "<i>&Delta;&rho;</i><sub>2</sub>=",
                   "type"     : "text",
		   "required" : "false",
		   "norow"    : "true",
		   "size"     : 4,   
		   "pattern"  : "^[-]?(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
		 },
	         {
                   "role"     : "input",
                   "id"       : "fdo2_2",
                   "label"    : "<i>f</i><sub>D<sub>2</sub>O</sub>+",
                   "type"     : "text",
		   "required" : "false",
		   "norow"    : "false",
		   "size"     : 4,   
		   "pattern"  : "^[-]?(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
		 },

#### Contrast Points ###############################################
		  { 
		   "role"     : "input",  
		   "id"       : "contrast_label",
		   "label"    : "CONTRAST POINTS",
		   "type"     : "label",
		   "prehline" : "true",
		   "posthline": "true"
	          },	
	         {
                   "role"     : "input",
                   "id"       : "upper_qr_limit",
                   "label"    : "Upper <i>qR<sub>g</sub></i> limit",
                   "type"     : "text",
		   "required" : "true",
		   "default"  : "1.3",
		   "size"     : 4,   
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },	

	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_compost",
                   "label"    : "Number of Contrast Points:",
                   "type"     : "integer",
		   "repeater" : "true",  
		   "tableize" : "true", 
		   "required" : "true",
		   "default"  : 3,
		   "min"      : 3,
		   "max"      : 15  
                  },

	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_fdo2",
                   "label"    : "<center><i>f</i><sub>D<sub>2</sub>O</sub>(0-1)</center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num_compost",   
		   "required" : "false",
		   "norow"    : "true",
		   "size"     : 4,   
		   "pattern"  : "^((0([.][0-9]*)?)|(1([.]00)?))$"
		 },
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_refine_scale",
                   "label"    : "<center>Refine Scale</center>",
                   "type"     : "checkbox",
		   "repeat"   : "contrast_points_num_compost",   
		   "checked"  : "true",
		   "required" : "true", 
		   "norow"    : "true"
		 },
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_scale_value",
                   "label"    : "<center>Scale Value</center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num_compost",   
		   "required" : "true",
		   "default"  : "1.0",
		   "norow"    : "true",
		   "size"     : 4,   
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_start_point",
                   "label"    : "Start Point",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num_compost",   
		   "required" : "true",
		   "default"  : 1,
		   "norow"    : "true",
		    "size"     : 4,   
		   "pattern"  : "^([1-9][0-9]?)$"  
		 },	
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_contrast_data",
                   "label"    : "<center>Contrast Data</center>",
                   "type"     : "file",
		   "repeat"   : "contrast_points_num_compost",
		   "required" : "true",  
		   "norow"    : "true"  
                   },	
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_delta_rho_1",
                   "label"    : "<center><i>&Delta;&rho;</i><sub>1</sub></center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num_compost",   
		   "required" : "true",
		   "norow"    : "true", 
		   "default"  : 0,
		   "min"      : 0,
		   "size"     : 4, 
		   "calc"     : "delta_rho_1*contrast_points_num_fdo2+fdo2_1", 
		   "pattern"  : "^(-)?(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_delta_rho_2",
                   "label"    : "<center><i>&Delta;&rho;</i><sub>2</sub></center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num_compost",   
		   "required" : "true",
		   "norow"    : "true",  
		   "default"  : 0,
		   "min"      : 0,
		   "size"     : 4, 
		   "calc"     : "delta_rho_2*contrast_points_num_fdo2+fdo2_2",    
		   "pattern"  : "^(-)?(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },	
	         {
                   "role"     : "input",
                   "id"       : "contrast_points_num_vol",
                   "label"    : "<center>Vol<sub>1</sub>/(Vol<sub>1</sub>+Vol<sub>2</sub>)</center>",
                   "type"     : "text",
		   "repeat"   : "contrast_points_num_compost",   
		   "required" : "true",
		   "default"  : 0,
		   "min"      : 0,
		   "size"     : 6,
		   "calc"     : "vol_1/(vol_1 + vol_2)",    
		   "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"  
		 },
####### OUTPUT ############################################################################
                  {
                   "role"  : "output",
                   "id"    : "outputfile",
                   "label" : "HTML:",
                   "type"  : "file"
                   },	
                 {
                   "role"  : "output",
                   "id"    : "output_html_label",
                   "label" : "OUTPUT HTML",
		   "prehline" : "true",
		   "posthline": "true",
                   "type"  : "label"
                   },	
	
                  {
                   "role"  : "output",
                   "id"    : "output_html",
                   "label" : "",
                   "type"  : "html"
                   }	
	],
# the executable will take inputs in order and produce output
    "executable"   : "compost.py",
    "submitpolicy" : "all"
}

