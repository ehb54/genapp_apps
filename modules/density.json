# this is a module file, any module specific info belongs here
{
    "moduleid" : "density",
    "label"    : "Density Plot",
    "fields"   : [
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "project name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "pdb reference file name",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile",
                   "label"    : "trajectory file name (pdb or dcd)",
                   "type"     : "file",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "ofile",
                   "label"    : "output file name prefix",
                   "type"     : "text",
		   "default"  : "1",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "xlength",
                   "label"    : "xlength (angstroms)",
                   "type"     : "text",
                   "default"  : "350",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "ylength",
                   "label"    : "ylength (angstroms)",
                   "type"     : "text",
                   "default"  : "350",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "zlength",
                   "label"    : "zlength (angstroms)",
                   "type"     : "text",
                   "default"  : "350",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "gridsp",
                   "label"    : "grid spacing (angstroms)",
                   "type"     : "text",
                   "default"  : "5.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "save_occupancy_list_box",
                   "name"    : "save_occupancy_list_box",
                   "label"   : "save occupancy information",
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "no"
                   },
                  {
                   "role"    : "input",
                   "id"      : "equalweights_list_box",
                   "name"    : "equalweights_list_box",
                   "label"   : "equal weights",
                   "type"    : "listbox",
                   "values"  : "yes~c1~no~c2",
                   "default" : "yes"
                   },
                  {
                   "role"     : "input",
                   "id"       : "weightfile",
                   "label"    : "weights file name",
                   "type"     : "text",
                   "default"  : "./run_0/filter/x2lowweights.txt",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "nsegments",
                   "label"    : "number of segments",
                   "type"     : "text",
                   "default"  : "1",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "nregions",
                   "label"    : "number of ranges",
                   "type"     : "text",
                   "default"  : "5",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "lowregions",
                   "label"    : "enter low regions",
                   "type"     : "text",
                   "default"  : "1,124,143,355,380",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "highregions",
                   "label"    : "enter high regions",
                   "type"     : "text",
                   "default"  : "123,142,353,379,420",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sbasis",
                   "label"    : "segment basis",
                   "type"     : "text",
                   "default"  : "CA",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sname",
                   "label"    : "segment name",
                   "type"     : "text",
                   "default"  : "GAG",
                   "required" : "true"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "density"
}
