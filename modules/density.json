# this is a module file, any module specific info belongs here
{
    "moduleid" : "density",
    "label"    : "Density Plot",
    "fields"   : [
                   {
                   "role"       : "input",
                   "id"       : "module_header",
                   "label"    : "Density Plot",
                   "type"     : "label",
                   "default"  : "header4",
                   "prehline"  : "true",
                   "posthline"  : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "runname",
                   "label"    : "run name",
                   "type"     : "text",
                   "default"  : "run_0",
                   "required" : "true",
                   "help"     : "results will be placed in a folder called density/ in the directory name you enter here"
                   },
                  {
                   "role"    : "input",
                   "id"      : "refpdb_list_box",
                   "name"    : "refpdb_list_box",
                   "label"   : "reference pdb",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use file on server~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile",
                   "label"    : "pdb reference file name",
                   "type"     : "file",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
		   "repeat"   : "refpdb_list_box:c1",
                   "norow"    : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "pdbfile_text",
                   "label"    : "pdb reference file name",
                   "type"     : "text",
                   "required" : "true",
                   "help"     : "name of PDB file for atom naming purposes",
		   "repeat"   : "refpdb_list_box:c2",
                   "norow"    : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "dcd_list_box",
                   "name"    : "dcd_list_box",
                   "label"   : "input filename (dcd or pdb)",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c1",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
                   "repeater" : "true",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile",
                   "label"    : "trajectory file name (dcd or pdb)",
                   "type"     : "file",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to create density plots",
                   "repeat"   : "dcd_list_box:c1",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "dcdfile_text",
                   "label"    : "trajectory file name (pdb or dcd)",
                   "type"     : "text",
                   "required" : "true",
                   "help"     : "name of DCD or PDB file with coordinates you wish to create density plots",
                   "repeat"   : "dcd_list_box:c2",
                   "norow" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "ofile",
                   "label"    : "output file name prefix",
                   "type"     : "text",
		   "default"  : "test",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "xlength",
                   "label"    : "xlength (angstroms)",
                   "type"     : "text",
                   "default"  : "350",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "ylength",
                   "label"    : "ylength (angstroms)",
                   "type"     : "text",
                   "default"  : "350",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "zlength",
                   "label"    : "zlength (angstroms)",
                   "type"     : "text",
                   "default"  : "350",
                   "required" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "gridsp",
                   "label"    : "grid spacing (angstroms)",
                   "type"     : "text",
                   "default"  : "5.0",
                   "required" : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "save_occupancy_list_box",
                   "name"    : "save_occupancy_list_box",
                   "label"   : "save occupancy information",
                   "type"    : "listbox",
                   "values"  : "no~c1~yes~c2",
                   "default" : "c1"
                   },
                  {
                   "role"    : "input",
                   "id"      : "weight_flag_check_box",
                   "label"    : "check box to use a weight file",
                   "type"    : "checkbox",
                   "checked" : "false",
                   "repeater" : "true",
		   "norow"   : "true"
                   },
                  {
                   "role"    : "input",
                   "id"      : "weight_flag_list_box",
                   "name"    : "weight_flag_list_box",
                   "label"   : "choose an input option",
                   "type"    : "listbox",
                   "values"  : "upload file~c1~use local file~c2",
                   "default" : "c2",
                   "help"    : "you can either upload a file from your machine or enter a file name that is in the current project directory",
		   "repeat"  : "weight_flag_check_box",
                   "repeater" : "true",
		   "norow"   : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "weightsfile",
                   "label"    : "weights file name",
                   "type"     : "file",
                   "help"     : "name of file containing weighting information for each structure in trajectory",
		   "norow"   : "true",
                   "repeat"   : "weight_flag_list_box:c1"
                   },
                  {
                   "role"     : "input",
                   "id"       : "weightsfile_text",
                   "label"    : "weights file name",
                   "type"     : "text",
		   "default"  : "run_0/filter/x2lowweights.txt",
                   "help"     : "name of file containing weighting information for each structure in trajectory",
		   "norow"   : "true",
                   "repeat"   : "weight_flag_list_box:c2"
                   },
                  {
                   "role"     : "input",
                   "id"       : "nsegments",
                   "label"    : "number of segments",
                   "type"     : "integer",
                   "default"  : 1,
                   "required" : "true",
		   "repeater" : "true"
                   },
                  {
                   "role"     : "input",
                   "id"       : "nregions",
                   "label"    : "number of ranges",
                   "type"     : "text",
                   "default"  : "5",
                   "required" : "true",
		   "norow"    : "true",
                   "repeat"  : "nsegments"
                   },
                  {
                   "role"     : "input",
                   "id"       : "lowregions",
                   "label"    : "enter low regions",
                   "type"     : "text",
                   "default"  : "1,124,143,355,380",
                   "required" : "true",
		   "norow"    : "true",
                   "repeat"  : "nsegments"
                   },
                  {
                   "role"     : "input",
                   "id"       : "highregions",
                   "label"    : "enter high regions",
                   "type"     : "text",
                   "default"  : "123,142,353,379,420",
                   "required" : "true",
		   "norow"    : "true",
                   "repeat"  : "nsegments"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sbasis",
                   "label"    : "segment basis",
                   "type"     : "text",
                   "default"  : "CA",
                   "required" : "true",
		   "norow"    : "true",
                   "repeat"  : "nsegments"
                   },
                  {
                   "role"     : "input",
                   "id"       : "sname",
                   "label"    : "segment name",
                   "type"     : "text",
                   "default"  : "GAG",
                   "required" : "true",
		   "norow"    : "true",
                   "repeat"  : "nsegments"
                   },
 		  {
                    "role"    : "output",
                    "id"      : "sasoutput2",
                    "name"    : "sasoutput2",
                    "label"   : " ",
                    "type"    : "textarea",
		    "rows"    : 20,
		    "cols"    : 80
		   }
                  ],
    "executable" : "density"
}
