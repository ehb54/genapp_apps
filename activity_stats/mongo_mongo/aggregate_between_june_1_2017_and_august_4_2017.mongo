db.jobs.aggregate(
	{
$match: {
module: 'sascalc',
start: {$gte : new ISODate("2014-06-01"), $lt : new ISODate("2018-06-04")}
}
}, {
$group: {
_id: '',
duration: { $sum: '$duration' },
avgDuration: { $avg: '$duration' },
count:    { $sum: 1 }
}
}, {
$project: {
_id: 0,
duration: '$duration',
count: 1,
avgDuration: 1

}
}
)
