############## AMINO ACID CONSTRAINTS #####################################################################
	        { 
		  "role"     : "input",  
		  "id"       : "aaconst",
		  "label"    : "AMINO ACID CONSTRAINTS",
		  "type"     : "label",
		  "prehline" : "true",
		  "posthline": "true",
		  "repeat"   : "num_states",  
		  "default"  : ""
		},
               { 
                   "role"     : "input",  
                   "id"       : "num_aaconst",
                   "label"    : "Number of Amino Acid Constraints: ",
                   "type"     : "integer",  
                   "required" : "yes",
                   "repeater" : "yes",
		   "default"  : 0,
		   "min"      : 0,
		   "repeat"   : "num_states",
 	           "help"     : ""
	       },
                { 
		  "role"     : "input",  
		  "id"       : "aa_number",
		  "label"    : "AA Number",
		  "type"     : "text",
		  "size"     : 3,
		  "required" : "true",
		  "repeat"   : "num_aaconst",
		  "default"  : "120",  
		  "pattern":"^((0)|([1-9][0-9]*))$"
		},

               { 
		  "role"     : "input",  
		  "id"       : "rdfl_number",
		  "label"    : "RD or FL Number",
		  "type"     : "text",
		  "size"     : 3, 
		  "required" : "true",
		  "repeat"   : "num_aaconst",
		   "default"  : "2",  
		  "pattern":"^((0)|([1-9][0-9]*))$"
		},
               { 
		  "role"     : "input",  
		  "id"       : "sym_number",
		  "label"    : "Symmetry Operation Number",
		  "type"     : "text",
		  "size"     : 3, 
		  "required" : "true",
		  "repeat"   : "num_aaconst",
		  "default"  : "1",  
		  "pattern":"^((0)|([1-9][0-9]*))$"
		},
                { 
		  "role"     : "input",  
		  "id"       : "screw_axis_number",
		  "label"    : "Screw-Axis Polymerization Number",
		  "type"     : "text",
		  "size"     : 3, 
		  "required" : "true",
		  "repeat"   : "num_aaconst" ,
		    "default"  : "1",  
		  "pattern":"^((0)|([1-9][0-9]*))$"
		},
               { 
		  "role"     : "input",  
		  "id"       : "atom_code",
		  "label"    : "Pdb Atom Code",
		  "type"     : "text",
		  "size"     : 3, 
		  "required" : "true",
		  "repeat"   : "num_aaconst",
		   "default" : "CA"
		},
               { 
		  "role"     : "input",  
		  "id"       : "coor_vect",
		  "label"    : "Coordinate Vector, R_i",
		  "type"     : "listbox",
		  "values"   : "x~x~y~y~z~z~r~r~a~a~b~b~rc~rc~ac~ac",
 		  #"repeater" : "true",
		  "required" : "true",
		  "repeat"   : "num_aaconst"  
		},
               { 
		  "role"     : "input",  
		  "id"       : "condition",
		  "label"    : "Condition",
		  "type"     : "listbox",
		  "values"   : "=~=~>~>~>=~>=~<~<~<=~<=~max~max~min~min",
 		  #"repeater" : "true",
		  "required" : "true",
		  "repeat"   : "num_aaconst"  
		},
               { 
		  "role"     : "input",  
		  "id"       : "val_name_vect",
		  "label"    : "Value, Name, Vector, U_d",
		  "type"     : "listbox",
		  "values"   : "value~value~name~name~x~x~y~y~z~z~r~r~a~a~b~b~rc~rc~ac~ac",
 		  "repeater" : "true",
		  "required" : "true",
		  "repeat"   : "num_aaconst"  
		},
              { 
		  "role"     : "input",  
		  "id"       : "val_name_vect_value",
		  "label"    : "Value: ",
		  "type"     : "text",
		  "required" : "true",
		  "size"     : 3,
		  "repeat"   : "val_name_vect:value",
		  "default"  : "10.0",
		  "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
		},
              { 
		  "role"     : "input",  
		  "id"       : "val_name_vect_name",
		  "label"    : "Name: ",
		  "type"     : "text",
		  "required" : "true",
		  "size"     : 3, 
		  "repeat"   : "val_name_vect:name",
		  "default"  : "ppp"
		},
               { 
		  "role"     : "input",  
		  "id"       : "fact_value",
		  "label"    : "Factor Value",
		  "type"     : "text",
		  "size"     : 3, 
		  "required" : "no",
		  "repeat"   : "num_aaconst",
		  "default"  : "1.0",
		  "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
	       },
               { 
		  "role"     : "input",  
		  "id"       : "method",
		  "label"    : "Method",
		  "type"     : "listbox",
		  "values"   : "st~st~el~el",
 		  #"repeater" : "true",
		  "required" : "true",
		  "repeat"   : "num_aaconst"  
		},
              { 
		  "role"     : "input",  
		  "id"       : "k",
		  "label"    : "K",
		  "type"     : "text",
		  "size"     : 3, 
		  "required" : "false",
		  "repeat"   : "num_aaconst",
		  "default"  : "12.0",
		  "pattern"  : "^(([1-9][0-9]*)|(0))?([.][0-9]+)?([eE][-+]?[0-9]+)?$"
	       },
              { 
		  "role"     : "input",  
		  "id"       : "name",
		  "label"    : "Name",
		  "type"     : "text",
		  "size"     : 3, 
		  "required" : "false",
		  "repeat"   : "num_aaconst"
	      },
              { 
		  "role"     : "input",  
		  "id"       : "flag",
		  "label"    : "Flag",
		  "type"     : "listbox",
		  "values"   : "0~zero~1~one",
		  "default"  : "zero",
		  "size"     : 3, 
		  "required" : "yes",
		  "repeat"   : "num_aaconst"  
	       },
