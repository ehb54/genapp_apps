			argv_io_string = StringIO(sys.argv[1])
			json_variables = json.load(argv_io_string)
			#json_variables = ast.literal_eval(argv_io_string)
		a=PDBScan_Drv()
		a.run_me(json_flag,json_variables,sys.argv[1])

